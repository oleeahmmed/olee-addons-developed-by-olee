<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The drawer of Modern CRM (same markup and classes, styled by modern_theme's sheet.scss) -->
    <t t-name="project_modern.FormDrawer">
        <Dialog title="props.title" size="'md'" contentClass="'o_pm_sheet o_or_sheet'" bodyClass="'or-sheet-body'" header="false">
            <aside class="or-sheet-rail" aria-label="Drawer actions">
                <button type="button" class="or-sheet-rail-btn" t-att-title="newLabel" t-att-aria-label="newLabel" t-on-click.stop="onNew">
                    <i class="fa fa-plus" aria-hidden="true"/>
                </button>
                <button type="button" class="or-sheet-rail-btn" aria-label="Close" title="Close" t-on-click.stop="close">
                    <span class="or-sheet-close-icon" aria-hidden="true">&#215;</span>
                </button>
            </aside>
            <div class="or-sheet-main">
                <div class="or-sheet-head">
                    <div class="or-sheet-head-text">
                        <h2 class="or-sheet-title" t-esc="props.title"/>
                        <p t-if="props.subtitle" class="or-sheet-subtitle" t-esc="props.subtitle"/>
                        <div t-if="props.slots and props.slots.actions" class="or-sheet-actions">
                            <t t-slot="actions"/>
                        </div>
                    </div>
                    <button type="button" class="or-sheet-close" aria-label="Close" title="Close" t-on-click.stop="close">
                        <span class="or-sheet-close-icon" aria-hidden="true">&#215;</span>
                    </button>
                </div>
                <div class="or-sheet-stack">
                    <t t-slot="default"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <t t-slot="footer"/>
            </t>
        </Dialog>
    </t>

    <t t-name="project_modern.Picker">
        <div class="pm-picker">
            <i class="fa fa-search pm-picker-icon" aria-hidden="true"/>
            <input t-att-id="props.id" type="text" class="or-input pm-picker-input" autocomplete="off"
                   t-att-placeholder="label or props.placeholder" t-att-value="state.editing ? state.q : label"
                   role="combobox" t-att-aria-expanded="state.open ? 'true' : 'false'"
                   t-on-input="onInput" t-on-focus="onFocus" t-on-blur="onBlur" t-on-keydown="onKeydown"/>
            <button t-if="props.allowEmpty and props.value" type="button" class="pm-picker-clear" title="Clear" aria-label="Clear"
                    t-on-mousedown.prevent="noop" t-on-click="clear">&#215;</button>
            <ul t-if="state.open and (state.results.length or !state.loading)" class="pm-picker-menu" role="listbox">
                <t t-foreach="state.results" t-as="r" t-key="r[0]">
                    <li role="option" t-att-aria-selected="r_index === state.active ? 'true' : 'false'"
                        t-att-class="{ 'is-active': r_index === state.active }"
                        t-on-mousedown.prevent="noop" t-on-click="() => this.pick(r)" t-esc="r[1]"/>
                </t>
                <li t-if="!state.results.length" class="pm-picker-empty">No match</li>
            </ul>
        </div>
    </t>

    <!-- "Open full form" / "More fields": Odoo's own form, full page -->
    <t t-name="project_modern.DrawerFullFormLink">
        <button type="button" class="or-link" t-on-click="openFullForm">
            <i class="fa fa-external-link me-1" aria-hidden="true"/><t t-if="isEdit">Open full form</t><t t-else="">More fields</t>
        </button>
    </t>

    <t t-name="project_modern.Error">
        <div t-if="state.error" class="or-error" role="alert"><i class="fa fa-exclamation-circle" aria-hidden="true"/><t t-esc="state.error"/></div>
    </t>

    <t t-name="project_modern.SaveFooter">
        <button type="button" class="or-save-pill" t-att-disabled="state.saving" t-on-click="save">Save</button>
    </t>

    <t t-name="project_modern.TaskDrawer">
        <FormDrawer title="title" subtitle="subtitle" close="props.close" onNew.bind="resetForm" newLabel="'New task'">
            <t t-set-slot="actions"><t t-call="project_modern.DrawerFullFormLink"/></t>
            <form class="or-sheet-fields" t-on-submit.prevent="save" novalidate="">
                <t t-call="project_modern.Error"/>
                <div class="or-field">
                    <label class="or-label" for="pm_tk_name">Title</label>
                    <input id="pm_tk_name" class="or-input" t-model="state.name" placeholder="e.g. Prepare the client presentation" autofocus=""/>
                </div>
                <div class="or-field">
                    <label class="or-label" for="pm_tk_project">Project</label>
                    <PmPicker id="'pm_tk_project'" resModel="'project.project'" domain="[['is_template', '=', false]]"
                              value="projectValue" placeholder="'Search a project…'" allowEmpty="true"
                              onSelect.bind="setProject"/>
                    <p class="or-hint">Leave empty for a private task (only you and the assignees see it).</p>
                </div>
                <div class="or-field">
                    <span class="or-label">Assignees</span>
                    <div class="or-sheet-chips pm-chips">
                        <t t-foreach="users" t-as="u" t-key="u.id">
                            <button type="button" class="or-chip pm-chip-user" t-att-class="{ 'is-on': state.user_ids.includes(u.id) }"
                                    t-on-click="() => this.toggle('user_ids', u.id)">
                                <img t-att-src="'/web/image/res.users/' + u.id + '/avatar_128'" alt="" class="pm-chip-avatar"/>
                                <t t-esc="u.name"/>
                            </button>
                        </t>
                    </div>
                </div>
                <div class="or-field or-field-row">
                    <div>
                        <label class="or-label" for="pm_tk_deadline">Deadline</label>
                        <input id="pm_tk_deadline" type="date" class="or-input" t-model="state.date_deadline"/>
                    </div>
                    <div>
                        <label class="or-label" for="pm_tk_priority">Priority</label>
                        <select id="pm_tk_priority" class="or-select" t-model="state.priority">
                            <t t-foreach="priorities" t-as="p" t-key="p.id"><option t-att-value="p.id" t-esc="p.label"/></t>
                        </select>
                    </div>
                </div>
                <div class="or-field" t-if="tags.length">
                    <span class="or-label">Tags</span>
                    <div class="or-sheet-chips">
                        <t t-foreach="tags" t-as="tg" t-key="tg.id">
                            <button type="button" class="or-chip" t-att-class="{ 'is-on': state.tag_ids.includes(tg.id) }"
                                    t-on-click="() => this.toggle('tag_ids', tg.id)">
                                <span t-attf-class="pm-dot o_colorlist_item_color_{{ tg.color or 0 }}" aria-hidden="true"/>
                                <t t-esc="tg.name"/>
                            </button>
                        </t>
                    </div>
                </div>
                <button type="submit" class="d-none"/>
            </form>
            <t t-set-slot="footer"><t t-call="project_modern.SaveFooter"/></t>
        </FormDrawer>
    </t>

    <t t-name="project_modern.ProjectDrawer">
        <FormDrawer title="title" subtitle="subtitle" close="props.close" onNew.bind="resetForm" newLabel="'New project'">
            <t t-set-slot="actions"><t t-call="project_modern.DrawerFullFormLink"/></t>
            <form class="or-sheet-fields" t-on-submit.prevent="save" novalidate="">
                <t t-call="project_modern.Error"/>
                <div class="or-field">
                    <label class="or-label" for="pm_pj_name">Project name</label>
                    <input id="pm_pj_name" class="or-input" t-model="state.name" placeholder="e.g. Office Design" autofocus=""/>
                </div>
                <div class="or-field">
                    <label class="or-label" for="pm_pj_partner">Customer</label>
                    <PmPicker id="'pm_pj_partner'" resModel="'res.partner'" value="state.partner_id"
                              placeholder="'Search a customer…'" allowEmpty="true"
                              onSelect="(v) => this.state.partner_id = v || false"/>
                </div>
                <div class="or-field">
                    <label class="or-label" for="pm_pj_manager">Project manager</label>
                    <PmPicker id="'pm_pj_manager'" resModel="'res.users'" domain="[['share', '=', false]]" value="state.user_id"
                              placeholder="'Search a user…'" allowEmpty="true"
                              onSelect="(v) => this.state.user_id = v || false"/>
                </div>
                <div class="or-field or-field-row">
                    <div>
                        <label class="or-label" for="pm_pj_start">Start date</label>
                        <input id="pm_pj_start" type="date" class="or-input" t-model="state.date_start"/>
                    </div>
                    <div>
                        <label class="or-label" for="pm_pj_end">End date</label>
                        <input id="pm_pj_end" type="date" class="or-input" t-model="state.date"/>
                    </div>
                </div>
                <div class="or-field" t-if="privacyOptions.length">
                    <label class="or-label" for="pm_pj_privacy">Who can see it</label>
                    <select id="pm_pj_privacy" class="or-select" t-model="state.privacy_visibility">
                        <t t-foreach="privacyOptions" t-as="p" t-key="p.id"><option t-att-value="p.id" t-esc="p.label"/></t>
                    </select>
                </div>
                <div class="or-field" t-if="tags.length">
                    <span class="or-label">Tags</span>
                    <div class="or-sheet-chips">
                        <t t-foreach="tags" t-as="tg" t-key="tg.id">
                            <button type="button" class="or-chip" t-att-class="{ 'is-on': state.tag_ids.includes(tg.id) }"
                                    t-on-click="() => this.toggle('tag_ids', tg.id)">
                                <span t-attf-class="pm-dot o_colorlist_item_color_{{ tg.color or 0 }}" aria-hidden="true"/>
                                <t t-esc="tg.name"/>
                            </button>
                        </t>
                    </div>
                </div>
                <button type="submit" class="d-none"/>
            </form>
            <t t-set-slot="footer"><t t-call="project_modern.SaveFooter"/></t>
        </FormDrawer>
    </t>

    <t t-name="project_modern.StageDrawer">
        <FormDrawer title="title" subtitle="subtitle" close="props.close" onNew.bind="resetForm" newLabel="'New stage'">
            <t t-set-slot="actions"><t t-call="project_modern.DrawerFullFormLink"/></t>
            <form class="or-sheet-fields" t-on-submit.prevent="save" novalidate="">
                <t t-call="project_modern.Error"/>
                <div class="or-field">
                    <label class="or-label" for="pm_st_name">Stage name</label>
                    <input id="pm_st_name" class="or-input" t-model="state.name" placeholder="e.g. In Review" autofocus=""/>
                </div>
                <div class="or-field">
                    <label class="or-label" for="pm_st_seq">Order</label>
                    <input id="pm_st_seq" type="number" min="0" step="1" class="or-input" t-model="state.sequence"/>
                    <p class="or-hint">Lower numbers come first on the board.</p>
                </div>
                <div class="or-field">
                    <span class="or-label">Projects</span>
                    <div class="or-sheet-chips">
                        <t t-foreach="projects" t-as="pj" t-key="pj.id">
                            <button type="button" class="or-chip" t-att-class="{ 'is-on': state.project_ids.includes(pj.id) }"
                                    t-on-click="() => this.toggle('project_ids', pj.id)" t-esc="pj.name"/>
                        </t>
                    </div>
                    <p class="or-hint">The boards that show this column.</p>
                </div>
                <div class="or-field or-field-row">
                    <div>
                        <span class="or-label">Folded on the board</span>
                        <button type="button" class="or-toggle" t-att-aria-checked="state.fold ? 'true' : 'false'"
                                t-att-class="{ 'is-on': state.fold }" t-on-click="() => this.state.fold = !this.state.fold"/>
                    </div>
                </div>
                <p class="or-hint">Tasks moved into a folded stage get their end date, as in Odoo.</p>
                <button type="submit" class="d-none"/>
            </form>
            <t t-set-slot="footer"><t t-call="project_modern.SaveFooter"/></t>
        </FormDrawer>
    </t>

    <t t-name="project_modern.TagDrawer">
        <FormDrawer title="title" subtitle="subtitle" close="props.close" onNew.bind="resetForm" newLabel="'New tag'">
            <t t-set-slot="actions"><t t-call="project_modern.DrawerFullFormLink"/></t>
            <form class="or-sheet-fields" t-on-submit.prevent="save" novalidate="">
                <t t-call="project_modern.Error"/>
                <div class="or-field">
                    <label class="or-label" for="pm_tg_name">Tag name</label>
                    <input id="pm_tg_name" class="or-input" t-model="state.name" placeholder="e.g. Design" autofocus=""/>
                </div>
                <div class="or-field">
                    <span class="or-label">Colour</span>
                    <div class="or-color-dots" role="radiogroup" aria-label="Colour">
                        <t t-foreach="colors" t-as="c" t-key="c">
                            <button type="button" role="radio" t-att-aria-checked="state.color === c ? 'true' : 'false'"
                                    t-attf-class="or-color-dot o_colorlist_item_color_{{ c }} {{ state.color === c ? 'is-on' : '' }}"
                                    t-on-click="() => this.state.color = c" t-att-title="'Colour ' + c"/>
                        </t>
                    </div>
                </div>
                <button type="submit" class="d-none"/>
            </form>
            <t t-set-slot="footer"><t t-call="project_modern.SaveFooter"/></t>
        </FormDrawer>
    </t>

</templates>
