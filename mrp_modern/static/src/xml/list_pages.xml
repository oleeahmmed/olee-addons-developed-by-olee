<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Odoo's own layout, full width: control panel (+, title, search, pager, views) then the view. -->
    <t t-name="mrp_modern.ListPage">
        <div class="o_mr o_mr_page o_mr_page--native">
            <div class="mr-container mr-container--native">
                <div t-if="!state.ready" class="mr-card mr-native">
                    <div class="mr-skeleton" style="height:3.5rem;margin:1rem 1.25rem"/>
                    <div class="mr-skeleton" style="height:16rem;margin:0 1.25rem 1.25rem"/>
                </div>
                <NativeView t-else="" t-key="state.version" t-props="nativeProps"/>
            </div>
        </div>
    </t>

</templates>
