<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        No app of its own: everything lives inside Odoo's Manufacturing app (mrp.menu_mrp_root).
        Home comes first, so opening Manufacturing from the home screen opens Manufacturing Modern.
        Sidebar: everyday pages only (Home, Dashboard, Operations, Products) — same idea as CRM/Sales.
        Top bar: Reporting and Configuration dropdowns. Visibility comes from Odoo's groups.
    -->
    <menuitem id="menu_home" name="Home" parent="mrp.menu_mrp_root" action="action_home"
              sequence="-110" groups="mrp.group_mrp_user"/>
    <menuitem id="menu_dashboard" name="Dashboard" parent="mrp.menu_mrp_root" action="action_dashboard"
              sequence="50" groups="mrp.group_mrp_user"/>

    <record id="menu_operations" model="ir.ui.menu">
        <field name="name">Operations</field>
        <field name="parent_id" ref="mrp.menu_mrp_root"/>
        <field name="sequence">-90</field>
        <field name="group_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        <field name="action" eval="False"/>
    </record>
    <menuitem id="menu_todo" name="To Do" parent="menu_operations" action="action_todo" sequence="1"/>
    <menuitem id="menu_mos" name="Manufacturing Orders" parent="menu_operations" action="action_mos" sequence="2"/>
    <menuitem id="menu_done" name="Done" parent="menu_operations" action="action_done" sequence="3"/>
    <menuitem id="menu_unbuild" name="Unbuild Orders" parent="menu_operations" action="action_unbuild" sequence="4"/>
    <menuitem id="menu_workorders" name="Work Orders" parent="menu_operations" action="action_workorders" sequence="5"
              groups="mrp.group_mrp_routings"/>

    <record id="menu_products" model="ir.ui.menu">
        <field name="name">Products</field>
        <field name="parent_id" ref="mrp.menu_mrp_root"/>
        <field name="sequence">-80</field>
        <field name="group_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        <field name="action" eval="False"/>
    </record>
    <menuitem id="menu_product_list" name="Products" parent="menu_products" action="action_products" sequence="1"/>
    <menuitem id="menu_boms" name="Bills of Materials" parent="menu_products" action="action_boms" sequence="2"/>

    <!-- Top bar (like CRM Reporting / Sales Team): not listed in the sidebar. -->
    <record id="menu_reporting" model="ir.ui.menu">
        <field name="name">Reporting</field>
        <field name="parent_id" ref="mrp.menu_mrp_root"/>
        <field name="sequence">-60</field>
        <field name="group_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        <field name="action" eval="False"/>
    </record>
    <menuitem id="menu_report_workorders" name="Work Orders" parent="menu_reporting" action="mrp.mrp_workorder_report"
              sequence="1" groups="mrp.group_mrp_routings"/>
    <menuitem id="menu_report_oee" name="Overall Equipment Effectiveness" parent="menu_reporting"
              action="mrp.mrp_workcenter_productivity_report" sequence="2" groups="mrp.group_mrp_routings"/>

    <record id="menu_config" model="ir.ui.menu">
        <field name="name">Configuration</field>
        <field name="parent_id" ref="mrp.menu_mrp_root"/>
        <field name="sequence">30</field>
        <field name="group_ids" eval="[(4, ref('mrp.group_mrp_manager'))]"/>
        <field name="action" eval="False"/>
    </record>
    <menuitem id="menu_settings" name="Settings" parent="menu_config" action="mrp.action_mrp_configuration"
              sequence="0" groups="base.group_system"/>
    <menuitem id="menu_workcenters" name="Work Centers" parent="menu_config" action="action_workcenters" sequence="1"
              groups="mrp.group_mrp_routings"/>
    <menuitem id="menu_operations_setup" name="Operations" parent="menu_config" action="mrp.mrp_routing_action"
              sequence="2" groups="mrp.group_mrp_routings"/>
</odoo>
