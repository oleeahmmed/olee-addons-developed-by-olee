<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        RFQ / purchase order: the details card keeps vendor, vendor reference and the
        dates. Currency and the "Ask confirmation" reminder move to Other Information.
    -->
    <record id="purchase_order_form_modern_details" model="ir.ui.view">
        <field name="name">purchase.order.form.modern.details</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_info']" position="inside">
                <xpath expr="//field[@name='partner_ref']/../field[@name='currency_id'][@groups='base.group_multi_currency']" position="move"/>
                <xpath expr="//label[@for='receipt_reminder_email']" position="move"/>
                <xpath expr="//div[@name='reminder']" position="move"/>
            </xpath>
        </field>
    </record>
</odoo>
