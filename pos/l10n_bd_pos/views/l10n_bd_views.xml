<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Company BIN (standalone form) -->
    <record id="res_company_vat_form" model="ir.ui.view">
        <field name="name">res.company.form.l10n_bd_vat</field>
        <field name="model">res.company</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="VAT registration">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <field name="l10n_bd_bin" placeholder="0000000000101"/>
                        <field name="vat" string="TIN / VAT"/>
                        <field name="l10n_bd_vat_area"/>
                        <field name="street"/>
                        <field name="city"/>
                        <field name="phone"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_company_vat" model="ir.actions.server">
        <field name="name">VAT registration (BIN)</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="group_ids" eval="[(4, ref('point_of_sale.group_pos_manager'))]"/>
        <field name="state">code</field>
        <!-- kept for the buttons that call it: opens the page below -->
        <field name="code">action = env['ir.actions.actions']._for_xml_id('l10n_bd_pos.action_company_vat_page')</field>
    </record>

    <!-- VAT registration: the company's BIN as a simple page in the drawer style (modern_theme.smart_form) -->
    <record id="action_company_vat_page" model="ir.actions.client">
        <field name="name">VAT registration (BIN)</field>
        <field name="tag">modern_theme.smart_form</field>
        <field name="path">pos-vat-registration</field>
        <field name="context">{'smart_form': 'res.company:vat', 'smart_form_res_id': 'company'}</field>
    </record>

    <!-- Taxes: VAT / SD / AT -->
    <record id="account_tax_bd_list" model="ir.ui.view">
        <field name="name">account.tax.list.l10n_bd</field>
        <field name="model">account.tax</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Taxes (Bangladesh)" editable="bottom" create="0">
                <field name="name" readonly="1"/>
                <field name="type_tax_use" readonly="1"/>
                <field name="amount_type" readonly="1"/>
                <field name="amount" readonly="1"/>
                <field name="price_include_override" optional="hide"/>
                <field name="l10n_bd_kind"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_bd_taxes" model="ir.actions.act_window">
        <field name="name">VAT / SD taxes</field>
        <field name="res_model">account.tax</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="account_tax_bd_list"/>
        <field name="domain">[('type_tax_use', '=', 'sale')]</field>
    </record>

    <!-- Products: Bangla name / H.S. code (standalone list) -->
    <record id="product_template_bd_list" model="ir.ui.view">
        <field name="name">product.template.list.l10n_bd</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Product names in Bangla" editable="bottom" create="0">
                <field name="default_code" readonly="1" optional="show"/>
                <field name="name" readonly="1"/>
                <field name="l10n_bd_name_bn"/>
                <field name="l10n_bd_hs_code" optional="show"/>
                <field name="taxes_id" widget="many2many_tags" optional="show"/>
                <field name="list_price" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="action_products_bn" model="ir.actions.act_window">
        <field name="name">Bangla names &amp; H.S. codes</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_template_bd_list"/>
        <field name="domain">[('available_in_pos', '=', True)]</field>
    </record>

    <!-- Customers: BIN (standalone list) -->
    <record id="res_partner_bd_list" model="ir.ui.view">
        <field name="name">res.partner.list.l10n_bd</field>
        <field name="model">res.partner</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Customers' BIN" editable="bottom" create="0">
                <field name="name" readonly="1"/>
                <field name="phone" readonly="1"/>
                <field name="l10n_bd_bin"/>
                <field name="vat" optional="show"/>
                <field name="street" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_partners_bin" model="ir.actions.act_window">
        <field name="name">Customers' BIN</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="res_partner_bd_list"/>
        <field name="domain">[('is_company', '=', True)]</field>
    </record>
    <!-- Counter settings of a shop: Bangladesh VAT -->
    <record id="pos_config_counter_form_l10n_bd" model="ir.ui.view">
        <field name="name">pos.config.counter.form.l10n_bd</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="pos_modern.pos_config_counter_form"/>
        <field name="arch" type="xml">
            <div name="pm_addons" position="inside">
                <group string="Bangladesh VAT (Mushak)" name="l10n_bd">
                    <field name="l10n_bd_mushak"/>
                    <field name="l10n_bd_receipt_lang"/>
                    <field name="l10n_bd_digits"/>
                    <field name="iface_tax_included" string="Prices shown"/>
                    <div colspan="2">
                        <button name="%(l10n_bd_pos.action_company_vat_page)d" type="action" string="Company BIN" icon="fa-id-card-o" class="btn-link"/>
                        <button name="%(l10n_bd_pos.action_bd_taxes)d" type="action" string="VAT / SD taxes" icon="fa-percent" class="btn-link"/>
                    </div>
                </group>
            </div>
        </field>
    </record>

</odoo>
