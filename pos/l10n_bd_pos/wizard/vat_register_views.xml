<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="vat_register_wizard_form" model="ir.ui.view">
        <field name="name">l10n.bd.pos.vat.register.form</field>
        <field name="model">l10n.bd.pos.vat.register</field>
        <field name="arch" type="xml">
            <form string="VAT sales register">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="config_ids" widget="many2many_tags" placeholder="All shops"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" type="object" string="Print PDF" class="btn-primary" icon="fa-print"/>
                    <button name="action_preview" type="object" string="Preview" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_vat_register_wizard" model="ir.actions.act_window">
        <field name="name">VAT sales register</field>
        <field name="res_model">l10n.bd.pos.vat.register</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
