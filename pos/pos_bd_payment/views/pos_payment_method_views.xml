<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Standalone list of the payment methods with the Bangladesh columns (no xpath into Odoo's views) -->
    <record id="pos_payment_method_bd_list" model="ir.ui.view">
        <field name="name">pos.payment.method.list.bd</field>
        <field name="model">pos.payment.method</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Payment methods (Bangladesh)" editable="bottom" create="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="journal_id" readonly="1" optional="show"/>
                <field name="bd_provider"/>
                <field name="bd_needs_trx"/>
                <field name="bd_needs_phone"/>
                <field name="bd_merchant_number"/>
                <field name="bd_trx_pattern" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="action_bd_payment_methods" model="ir.actions.act_window">
        <field name="name">Payment methods (BD)</field>
        <field name="res_model">pos.payment.method</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="pos_payment_method_bd_list"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No payment method yet</p>
            <p>Open a shop's Counter settings and click "Set up BD wallets" to create bKash, Nagad, Rocket and Upay.</p>
        </field>
    </record>

    <record id="pos_payment_bd_list" model="ir.ui.view">
        <field name="name">pos.payment.list.bd</field>
        <field name="model">pos.payment</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Wallet payments" create="0" editable="bottom">
                <field name="payment_date" readonly="1"/>
                <field name="pos_order_id" readonly="1"/>
                <field name="payment_method_id" readonly="1"/>
                <field name="transaction_id" string="TrxID"/>
                <field name="bd_payer_phone"/>
                <field name="amount" sum="Total" readonly="1"/>
                <field name="bd_verified" widget="boolean_toggle"/>
                <field name="bd_verified_by" optional="hide"/>
            </list>
        </field>
    </record>
</odoo>
