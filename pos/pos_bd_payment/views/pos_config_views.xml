<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_counter_form_bd" model="ir.ui.view">
        <field name="name">pos.config.counter.form.bd_payment</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="pos_modern.pos_config_counter_form"/>
        <field name="arch" type="xml">
            <div name="pm_addons" position="inside">
                <group string="Bangladesh payments" name="bd_payment">
                    <div colspan="2" class="text-muted">
                        bKash, Nagad, Rocket and Upay as separate tenders with their own journal, the TrxID asked at the counter.
                    </div>
                    <field name="payment_method_ids" widget="many2many_tags" readonly="1"/>
                    <div colspan="2">
                        <button name="pos_bd_setup_wallets" type="object" string="Set up BD wallets" icon="fa-mobile" class="btn-secondary"/>
                        <button name="%(pos_bd_payment.action_bd_payment_methods)d" type="action" string="Payment methods" icon="fa-list" class="btn-link"/>
                        <button name="%(pos_bd_payment.action_sms_page)d" type="action" string="SMS gateway" icon="fa-commenting-o" class="btn-link"/>
                    </div>
                </group>
            </div>
        </field>
    </record>

    <record id="action_reconcile" model="ir.actions.client">
        <field name="name">Wallet reconciliation</field>
        <field name="tag">pos_bd_payment.reconcile</field>
        <field name="path">pos-wallet-reconcile</field>
    </record>
</odoo>
