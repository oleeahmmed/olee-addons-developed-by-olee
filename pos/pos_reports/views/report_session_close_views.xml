<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_report_pos_session_close_list" model="ir.ui.view">
        <field name="name">report.pos.session.close.list</field>
        <field name="model">report.pos.session.close</field>
        <field name="arch" type="xml">
            <list string="Session Closing" create="0" edit="0" delete="0"
                  decoration-danger="difference != 0 and state == 'closed'">
                <field name="name" string="Session"/>
                <field name="config_id" string="Point of Sale" optional="hide"/>
                <field name="cashier_id" string="Cashier" optional="hide"/>
                <field name="state" string="Status" widget="badge"
                    decoration-success="state == 'closed'"
                    decoration-warning="state == 'opened'"
                    decoration-muted="state in ('opening_control', 'closing_control')"/>
                <field name="start_at" string="Opened" optional="hide"/>
                <field name="stop_at" string="Closed"/>
                <field name="order_count" string="Orders" sum="Orders"/>
                <field name="total_sales" string="Sales" sum="Sales"/>
                <field name="opening_cash" string="Opening Cash"/>
                <field name="cash_sales" string="Cash Sales"/>
                <field name="other_sales" string="Card / bKash" optional="hide"/>
                <field name="cash_in" string="Cash In" optional="hide"/>
                <field name="cash_out" string="Cash Out" optional="hide"/>
                <field name="expected_cash" string="Expected"/>
                <field name="counted_cash" string="Counted"/>
                <field name="difference" string="Difference"/>
                <field name="company_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_report_pos_session_close_search" model="ir.ui.view">
        <field name="name">report.pos.session.close.search</field>
        <field name="model">report.pos.session.close</field>
        <field name="arch" type="xml">
            <search string="Session Closing">
                <field name="name" string="Session"/>
                <field name="config_id" string="Point of Sale"/>
                <field name="cashier_id" string="Cashier"/>
                <field name="start_at" string="Opened"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <filter name="open" string="Open" domain="[('state', '=', 'opened')]"/>
                <filter name="today" string="Today"
                        domain="[('start_at', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="week" string="Last 7 Days"
                        domain="[('start_at', '&gt;=', (context_today() + relativedelta(days=-6)).strftime('%Y-%m-%d'))]"/>
                <filter name="month" string="This Month"
                        domain="[('start_at', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="mismatch" string="Cash Mismatch" domain="[('difference', '!=', 0), ('state', '=', 'closed')]"/>
                <separator/>
                <filter name="group_config" string="Point of Sale" context="{'group_by': 'config_id'}"/>
                <filter name="group_cashier" string="Cashier" context="{'group_by': 'cashier_id'}"/>
                <filter name="group_month" string="Month" context="{'group_by': 'start_at:month'}"/>
            </search>
        </field>
    </record>

    <record id="action_report_pos_session_close" model="ir.actions.act_window">
        <field name="name">Session Closing</field>
        <field name="res_model">report.pos.session.close</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sessions in this period</p>
            <p>Each session with opening cash, cash and card sales, cash in and out, expected cash, counted cash and the short or excess amount.</p>
        </field>
    </record>

</odoo>