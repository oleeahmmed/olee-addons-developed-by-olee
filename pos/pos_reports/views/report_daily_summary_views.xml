<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_report_pos_daily_summary_list" model="ir.ui.view">
        <field name="name">report.pos.daily.summary.list</field>
        <field name="model">report.pos.daily.summary</field>
        <field name="arch" type="xml">
            <list string="Daily Business Summary" create="0" edit="0" delete="0"
                  decoration-danger="net_profit &lt; 0">
                <field name="date"/>
                <field name="company_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="order_count" sum="Orders"/>
                <field name="sales_total" sum="Sales"/>
                <field name="returns_total" sum="Returns"/>
                <field name="net_sales" sum="Net Sales"/>
                <field name="tax_total" sum="Tax" optional="hide"/>
                <field name="cost_total" sum="Cost" optional="hide"/>
                <field name="gross_profit" sum="Gross Profit"/>
                <field name="cash_sales" sum="Cash Sales" optional="hide"/>
                <field name="other_sales" sum="Card / bKash Sales" optional="hide"/>
                <field name="cash_in" sum="Cash In" optional="hide"/>
                <field name="cash_out" string="Expenses" sum="Expenses"/>
                <field name="purchases" sum="Purchases" optional="hide"/>
                <field name="receivables_collected" sum="Receivables Collected" optional="hide"/>
                <field name="supplier_payments" sum="Supplier Payments" optional="hide"/>
                <field name="cash_balance" string="Cash in Hand"/>
                <field name="bank_balance" string="Bank / bKash"/>
                <field name="net_profit" sum="Net Profit"/>
            </list>
        </field>
    </record>

    <record id="view_report_pos_daily_summary_pivot" model="ir.ui.view">
        <field name="name">report.pos.daily.summary.pivot</field>
        <field name="model">report.pos.daily.summary</field>
        <field name="arch" type="xml">
            <pivot string="Daily Business Summary">
                <field name="date" type="row" interval="month"/>
                <field name="sales_total" type="measure"/>
                <field name="cost_total" type="measure"/>
                <field name="gross_profit" type="measure"/>
                <field name="cash_out" type="measure"/>
                <field name="net_profit" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_report_pos_daily_summary_search" model="ir.ui.view">
        <field name="name">report.pos.daily.summary.search</field>
        <field name="model">report.pos.daily.summary</field>
        <field name="arch" type="xml">
            <search string="Daily Business Summary">
                <field name="date"/>
                <field name="company_id"/>
                <filter name="today" string="Today"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="week" string="Last 7 Days"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(days=-6)).strftime('%Y-%m-%d'))]"/>
                <filter name="month" string="This Month"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="year" string="This Year"
                        domain="[('date', '&gt;=', (context_today() + relativedelta(month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="loss" string="Loss Days" domain="[('net_profit', '&lt;', 0)]"/>
                <separator/>
                <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_report_pos_daily_summary" model="ir.actions.act_window">
        <field name="name">Daily Business Summary</field>
        <field name="res_model">report.pos.daily.summary</field>
        <field name="view_mode">list,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No business activity in this period</p>
            <p>One row per business day: sales, returns, cost, gross profit, cash and card sales, expenses, purchases, receivables, supplier payments, cash in hand, bank balance and net profit.</p>
        </field>
    </record>

</odoo>