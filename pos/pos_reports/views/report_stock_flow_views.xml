<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_report_pos_stock_flow_list" model="ir.ui.view">
        <field name="name">report.pos.stock.flow.list</field>
        <field name="model">report.pos.stock.flow</field>
        <field name="arch" type="xml">
            <list string="Stock Movement" create="0" edit="0" delete="0"
                  decoration-danger="status == 'dead'"
                  decoration-success="status == 'fast'">
                <field name="product_id"/>
                <field name="categ_id" string="Category"/>
                <field name="status" widget="badge"
                    decoration-danger="status == 'dead'"
                    decoration-warning="status == 'slow'"
                    decoration-success="status == 'fast'"/>
                <field name="on_hand" sum="On Hand"/>
                <field name="stock_value" sum="Stock Value"/>
                <field name="qty_sold_30" string="Sold 30d" sum="Sold 30d"/>
                <field name="qty_sold_60" string="Sold 60d" sum="Sold 60d" optional="hide"/>
                <field name="qty_sold_90" string="Sold 90d" sum="Sold 90d"/>
                <field name="last_sale_date" optional="hide"/>
                <field name="days_since_last_sale"/>
                <field name="company_id" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_report_pos_stock_flow_pivot" model="ir.ui.view">
        <field name="name">report.pos.stock.flow.pivot</field>
        <field name="model">report.pos.stock.flow</field>
        <field name="arch" type="xml">
            <pivot string="Stock Movement">
                <field name="categ_id" type="row"/>
                <field name="on_hand" type="measure"/>
                <field name="stock_value" type="measure"/>
                <field name="qty_sold_90" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_report_pos_stock_flow_search" model="ir.ui.view">
        <field name="name">report.pos.stock.flow.search</field>
        <field name="model">report.pos.stock.flow</field>
        <field name="arch" type="xml">
            <search string="Stock Movement">
                <field name="product_id"/>
                <field name="categ_id" string="Category"/>
                <filter name="dead" string="Dead Stock" domain="[('status', '=', 'dead')]"/>
                <filter name="slow" string="Slow Moving" domain="[('status', '=', 'slow')]"/>
                <filter name="fast" string="Fast Moving" domain="[('status', '=', 'fast')]"/>
                <filter name="in_stock" string="In Stock" domain="[('on_hand', '&gt;', 0)]"/>
                <separator/>
                <filter name="group_category" string="Category" context="{'group_by': 'categ_id'}"/>
                <filter name="group_status" string="Movement" context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="action_report_pos_stock_flow" model="ir.actions.act_window">
        <field name="name">Stock Movement</field>
        <field name="res_model">report.pos.stock.flow</field>
        <field name="view_mode">list,pivot</field>
        <field name="context">{'search_default_in_stock': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No stock or sales yet</p>
            <p>Products with their stock on hand, stock value and sold quantities over the last 30, 60 and 90 days. Filter Dead Stock to see money sitting on the shelf.</p>
        </field>
    </record>

</odoo>