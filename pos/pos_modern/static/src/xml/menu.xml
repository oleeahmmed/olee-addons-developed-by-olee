<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        The counter. Shop addons add things with t-inherit (t-inherit-mode="extension")
        into the empty .ps-hook-* elements: they are kept from version to version.
    -->
    <t t-name="pos_modern.Menu">
        <div class="o_ps ps-pos" t-att-class="{ 'is-paying': state.mode === 'pay' }">
            <t t-if="state.loading">
                <div class="ps-pos-main"><div class="ps-skel" style="height:3rem;width:18rem"/><div class="ps-skel" style="height:6rem;margin-top:1rem"/><div class="ps-skel" style="height:24rem;margin-top:1rem"/></div>
                <aside class="ps-cart"><div class="ps-skel" style="height:100%"/></aside>
            </t>
            <t t-elif="!state.data.config_id">
                <div class="ps-pos-empty">
                    <i class="fa fa-shopping-basket" aria-hidden="true"/>
                    <strong>No shop yet</strong>
                    <span>Create a shop (a register) to start selling.</span>
                    <button type="button" class="ps-btn ps-btn--primary" t-on-click="() => this.action.doAction('pos_modern.action_shops')">Go to Shops</button>
                </div>
            </t>
            <t t-else="">
                <t t-set="d" t-value="state.data"/>
                <!-- products -->
                <section class="ps-pos-main">
                    <header class="ps-pos-head">
                        <div class="ps-pos-title">
                            <h1>Point of Sale</h1>
                            <div class="ps-pos-shop">
                                <label class="ps-select">
                                    <i class="fa fa-shopping-basket" aria-hidden="true"/>
                                    <select t-on-change="onShop" aria-label="Shop">
                                        <t t-foreach="d.shops" t-as="s" t-key="s.id">
                                            <option t-att-value="s.id" t-att-selected="s.id === d.config_id" t-esc="s.name"/>
                                        </t>
                                    </select>
                                </label>
                                <span t-if="sessionOpen" class="ps-pill ps-pill--success"><span class="ps-dot-live"/>Open<t t-if="session.user"> · <t t-esc="session.user"/></t></span>
                                <span t-elif="sessionClosing" class="ps-pill ps-pill--warning">Closing</span>
                                <span t-else="" class="ps-pill">Closed</span>
                                <span t-if="!state.online" class="ps-pill ps-pill--danger" title="The server cannot be reached: orders are kept in this browser"><i class="fa fa-wifi" aria-hidden="true"/> Offline</span>
                                <button t-if="state.queue" type="button" class="ps-pill ps-pill--warning ps-pill-btn" t-on-click="syncQueue" title="Send the orders kept offline">
                                    <i class="fa fa-cloud-upload" aria-hidden="true"/> <t t-esc="state.queue"/> to send
                                </button>
                            </div>
                        </div>
                        <div class="ps-pos-actions">
                            <div class="ps-hook-head-actions"/>
                            <button type="button" class="ps-btn" t-on-click="openReturn" title="Return or exchange an earlier bill"><i class="fa fa-undo" aria-hidden="true"/> Return</button>
                            <button type="button" class="ps-btn ps-btn--icon" t-on-click="openLabels" title="Barcode labels"><i class="fa fa-barcode" aria-hidden="true"/></button>
                            <button type="button" class="ps-btn" t-on-click="openHeld" title="Held bills (F7)">
                                <i class="fa fa-pause-circle-o" aria-hidden="true"/> Held<span t-if="d.held_count" class="ps-btn-badge" t-esc="d.held_count"/>
                            </button>
                            <button t-if="d.restaurant" type="button" class="ps-btn" t-on-click="goTables"><i class="fa fa-th" aria-hidden="true"/> Tables</button>
                            <button t-if="session" type="button" class="ps-btn" t-on-click="dayEnd" title="X / Z report, cash in / out, close the day"><i class="fa fa-calendar-check-o" aria-hidden="true"/> Day end</button>
                            <button type="button" class="ps-btn ps-btn--icon" t-on-click="newProduct" title="New product"><i class="fa fa-plus" aria-hidden="true"/></button>
                            <button t-if="features.is_manager" type="button" class="ps-btn ps-btn--icon" t-on-click="openSettings" title="Counter settings"><i class="fa fa-cog" aria-hidden="true"/></button>
                            <label class="ps-search">
                                <i class="fa fa-search" aria-hidden="true"/>
                                <input t-ref="search" type="search" placeholder="Search or scan… (F2)" t-model="state.search" t-on-keydown="onSearchKey" aria-label="Search products"/>
                            </label>
                        </div>
                    </header>

                    <div class="ps-hook-main-top"/>
                    <nav class="ps-cats" aria-label="Categories">
                        <button type="button" class="ps-cat" t-att-class="{ 'is-on': state.category === 'all' }" t-on-click="() => this.setCategory('all')">
                            <span class="ps-cat-icon ps-cat-icon--all"><i class="fa fa-th-large" aria-hidden="true"/></span>
                            <span class="ps-cat-name">All</span>
                        </button>
                        <t t-foreach="categories" t-as="c" t-key="c.id">
                            <button type="button" class="ps-cat" t-att-class="{ 'is-on': state.category === c.id }" t-on-click="() => this.setCategory(c.id)">
                                <img t-if="c.image" class="ps-cat-icon" t-att-src="categoryImage(c)" alt="" loading="lazy"/>
                                <span t-else="" t-attf-class="ps-cat-icon ps-tone-{{ tone(c.id) }}" t-esc="initials(c.name)"/>
                                <span class="ps-cat-name" t-esc="c.name"/>
                            </button>
                        </t>
                    </nav>

                    <div t-if="!products.length" class="ps-pos-empty ps-pos-empty--inline">
                        <i class="fa fa-cube" aria-hidden="true"/>
                        <strong>No product here</strong>
                        <span t-if="state.search">Press Enter to search all the products.</span>
                        <span t-else="">Products "Available in POS" show up on this menu.</span>
                    </div>
                    <div t-else="" class="ps-grid">
                        <t t-foreach="products" t-as="p" t-key="p.id">
                            <t t-set="st" t-value="stockState(p)"/>
                            <button type="button" t-attf-class="ps-prod {{ st ? 'ps-stock-' + st : '' }}" t-att-class="{ 'is-in': qtyOf(p) }" t-on-click="() => this.onProduct(p)" t-att-title="p.name">
                                <span class="ps-prod-img">
                                    <img t-if="p.image" t-att-src="productImage(p)" alt="" loading="lazy"/>
                                    <span t-else="" t-attf-class="ps-prod-ph ps-tone-{{ tone(p.id) }}" t-esc="initials(p.name)"/>
                                    <span t-if="qtyOf(p)" class="ps-prod-qty" t-esc="qtyOf(p)"/>
                                    <span t-if="st" t-attf-class="ps-prod-stock ps-prod-stock--{{ st }}" t-esc="stockLabel(p)"/>
                                </span>
                                <span class="ps-prod-body">
                                    <span class="ps-prod-text">
                                        <span class="ps-prod-name" t-esc="p.name"/>
                                        <span class="ps-hook-prod-meta"/>
                                        <span class="ps-prod-price" t-esc="money(price(p))"/>
                                    </span>
                                    <span class="ps-prod-add" aria-hidden="true"><i class="fa fa-cart-plus"/></span>
                                </span>
                            </button>
                        </t>
                    </div>
                    <div class="ps-keys" aria-hidden="true">
                        <t t-foreach="shortcuts" t-as="k" t-key="k[0]"><span><kbd t-esc="k[0]"/> <t t-esc="k[1]"/></span></t>
                    </div>
                </section>

                <!-- cart / payment -->
                <aside class="ps-cart" aria-label="Your Cart">
                    <div class="ps-cart-head">
                        <h2 t-if="state.mode === 'pay'">Payment</h2>
                        <h2 t-else="">Your Cart</h2>
                        <span t-if="itemCount" class="ps-cart-count" t-esc="itemCount"/>
                        <span t-if="state.holdId" class="ps-pill ps-pill--info">Held bill</span>
                        <button t-if="state.mode === 'pay'" type="button" class="ps-link ms-auto" t-on-click="backToCart"><i class="fa fa-arrow-left" aria-hidden="true"/> Cart</button>
                        <button t-elif="state.cart.length" type="button" class="ps-link ms-auto" t-on-click="clearCart">Clear</button>
                    </div>
                    <div t-if="state.tableId" class="ps-cart-table">
                        <i class="fa fa-cutlery" aria-hidden="true"/> <span t-esc="state.tableName or 'Table'"/>
                        <button type="button" class="ps-link ms-auto" t-on-click="clearTable" title="Remove the table">&#215;</button>
                    </div>
                    <div class="ps-hook-cart-top"/>

                    <!-- session closed -->
                    <div t-if="!sessionOpen" class="ps-cart-session">
                        <i class="fa fa-lock" aria-hidden="true"/>
                        <t t-if="sessionClosing">
                            <strong>The session is being closed</strong>
                            <span>Finish closing it (Day end), then open a new one.</span>
                            <button type="button" class="ps-btn" t-on-click="dayEnd">Day end</button>
                        </t>
                        <t t-else="">
                            <strong>Open the shop to sell</strong>
                            <span>Start the session of <t t-esc="d.config_name"/>.</span>
                            <label t-if="d.cash_control" class="ps-field">
                                <span>Cash in the drawer</span>
                                <input type="number" min="0" step="0.01" inputmode="decimal" class="ps-input" t-model="state.openingCash" placeholder="0"/>
                            </label>
                            <button type="button" class="ps-btn ps-btn--primary ps-btn--block" t-att-disabled="state.busy" t-on-click="openSession">
                                <i class="fa fa-unlock" aria-hidden="true"/> Open session
                            </button>
                        </t>
                    </div>

                    <!-- order paid -->
                    <div t-elif="state.done" class="ps-cart-done">
                        <span class="ps-done-icon" t-att-class="{ 'is-offline': state.done.offline }"><i t-attf-class="fa {{ state.done.offline ? 'fa-cloud-upload' : 'fa-check' }}" aria-hidden="true"/></span>
                        <strong t-if="state.done.offline">Kept offline</strong>
                        <strong t-else="">Order paid</strong>
                        <span class="ps-done-ref" t-esc="state.done.name"/>
                        <span class="ps-done-total" t-esc="money(state.done.total)"/>
                        <div t-if="state.done.change" class="ps-done-change">
                            <span>Change</span><strong t-esc="money(state.done.change)"/>
                        </div>
                        <div class="ps-hook-done-extra"/>
                        <button type="button" class="ps-btn ps-btn--primary ps-btn--block" t-on-click="newOrder"><i class="fa fa-plus" aria-hidden="true"/> New order</button>
                        <div class="ps-row">
                            <button type="button" class="ps-btn" t-on-click="() => this.printReceipt()"><i class="fa fa-print" aria-hidden="true"/> Receipt</button>
                            <button t-if="state.done.id" type="button" class="ps-btn" t-on-click="openOrder">View order</button>
                        </div>
                    </div>

                    <!-- payment -->
                    <t t-elif="state.mode === 'pay'">
                        <div class="ps-paypanel">
                            <div class="ps-pay-due" t-att-class="{ 'is-back': isRefund }">
                                <span t-if="isRefund">To give back</span>
                                <span t-else="">To pay</span>
                                <strong t-esc="money(isRefund ? -payable : payable)"/>
                                <small t-if="rounding">Rounding <t t-esc="money(rounding)"/></small>
                            </div>
                            <div class="ps-pay" role="group" aria-label="Payment methods">
                                <t t-foreach="methods" t-as="m" t-key="m.id">
                                    <button type="button" t-attf-class="ps-pay-btn ps-pay-btn--{{ m.kind }}" t-att-data-provider="m.provider or ''" t-on-click="() => this.addTender(m)">
                                        <i t-attf-class="fa {{ m.icon or (m.is_cash ? 'fa-money' : (m.kind === 'later' ? 'fa-book' : 'fa-credit-card')) }}" aria-hidden="true"/>
                                        <span t-esc="m.name"/>
                                    </button>
                                </t>
                            </div>
                            <ul class="ps-tenders">
                                <t t-foreach="state.payments" t-as="p" t-key="p.uid">
                                    <t t-set="pm" t-value="method(p.method_id)"/>
                                    <li class="ps-tender">
                                        <div class="ps-tender-row">
                                            <span class="ps-tender-name" t-esc="pm ? pm.name : ''"/>
                                            <input type="number" min="0" step="0.01" inputmode="decimal" class="ps-input ps-tender-amount"
                                                   t-att-value="p.amount" t-on-input="(ev) => this.setTenderAmount(p, ev.target.value)" aria-label="Amount"/>
                                            <button type="button" class="ps-link" t-on-click="() => this.removeTender(p)" aria-label="Remove">&#215;</button>
                                        </div>
                                        <input t-if="pm and pm.needs_ref" type="text" class="ps-input ps-tender-ref" t-att-placeholder="pm.ref_label or 'Transaction ID'"
                                               t-att-value="p.ref" t-on-input="(ev) => p.ref = ev.target.value.toUpperCase().trim()" autocomplete="off"/>
                                        <input t-if="pm and pm.needs_phone" type="tel" class="ps-input ps-tender-ref" placeholder="Payer's mobile number"
                                               t-att-value="p.phone" t-on-input="(ev) => p.phone = ev.target.value"/>
                                        <div class="ps-hook-pay-tender"/>
                                    </li>
                                </t>
                            </ul>
                            <div t-if="!isRefund and features.quick_cash and features.quick_cash.length" class="ps-quick">
                                <button type="button" class="ps-chip" t-on-click="exactCash">Exact</button>
                                <t t-foreach="features.quick_cash" t-as="n" t-key="n_index">
                                    <button type="button" class="ps-chip" t-on-click="() => this.quickCash(n)" t-esc="money(n)"/>
                                </t>
                            </div>
                            <dl class="ps-sum">
                                <div><dt>Paid</dt><dd t-esc="money(paid)"/></div>
                                <div t-if="!isRefund and remaining > 0" class="ps-sum-due"><dt>Still due</dt><dd t-esc="money(remaining)"/></div>
                                <div t-if="change > 0" class="ps-sum-change"><dt>Change</dt><dd t-esc="money(change)"/></div>
                            </dl>
                            <div class="ps-hook-pay-extra"/>
                            <div t-if="needsPin" class="ps-note ps-note--warning"><i class="fa fa-lock" aria-hidden="true"/> The discount is over your limit: a manager PIN is asked.</div>
                            <div t-if="state.error" class="ps-error" t-esc="state.error"/>
                            <button type="button" class="ps-btn ps-btn--primary ps-btn--block ps-btn--lg"
                                    t-att-disabled="state.busy or !settled" t-on-click="validate">
                                <t t-if="state.busy"><i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/> Saving…</t>
                                <t t-else=""><i class="fa fa-check" aria-hidden="true"/> Validate (F9)</t>
                            </button>
                        </div>
                    </t>

                    <!-- cart -->
                    <t t-else="">
                        <div t-if="!cartLines.length" class="ps-cart-empty">
                            <span class="ps-cart-empty-icon">🛒</span>
                            <span>Your cart is empty.</span>
                            <small>Tap a product or scan a barcode.</small>
                        </div>
                        <ul t-else="" class="ps-lines">
                            <t t-foreach="cartLines" t-as="l" t-key="l.key">
                                <li class="ps-line" t-att-class="{ 'is-editing': state.editKey === l.key, 'is-back': l.qty &lt; 0 }">
                                    <div class="ps-line-main">
                                        <span class="ps-line-img" t-on-click="() => this.toggleEdit(l)">
                                            <img t-if="l.product.image" t-att-src="productImage(l.product)" alt=""/>
                                            <span t-else="" t-attf-class="ps-prod-ph ps-tone-{{ tone(l.id) }}" t-esc="initials(l.product.name)"/>
                                        </span>
                                        <button type="button" class="ps-line-text" t-on-click="() => this.toggleEdit(l)">
                                            <span class="ps-line-name" t-esc="l.product.name"/>
                                            <span class="ps-line-price">
                                                <t t-esc="money(lineTotal(l))"/>
                                                <s t-if="lineGross(l) - lineTotal(l) > 0.004" class="ps-line-gross" t-esc="money(lineGross(l))"/>
                                                <span t-if="l.discount" class="ps-tag ps-tag--success">-<t t-esc="l.discount"/>%</span>
                                            </span>
                                            <span t-if="l.label or (l.quoted and l.quoted.label)" class="ps-line-label" t-esc="l.label or l.quoted.label"/>
                                            <span class="ps-hook-line-meta"/>
                                        </button>
                                        <span t-if="l.qty &lt; 0" class="ps-line-qty ps-line-qty--back"><t t-esc="l.qty"/></span>
                                        <span t-else="" class="ps-step">
                                            <button type="button" aria-label="Decrease" t-on-click="() => this.decrease(l)">−</button>
                                            <span t-esc="l.qty"/>
                                            <button type="button" aria-label="Increase" t-on-click="() => this.increase(l)">+</button>
                                        </span>
                                    </div>
                                    <div t-if="state.editKey === l.key" class="ps-line-edit">
                                        <label class="ps-field ps-field--inline"><span>Qty</span>
                                            <input type="number" min="0" step="0.001" inputmode="decimal" class="ps-input" t-att-value="l.qty" t-on-change="(ev) => this.setQty(l, ev.target.value)"/>
                                        </label>
                                        <label class="ps-field ps-field--inline"><span>Discount %</span>
                                            <input type="number" min="0" max="100" step="0.5" inputmode="decimal" class="ps-input" t-att-value="l.discount" t-on-change="(ev) => this.setLineDiscount(l, ev.target.value)"/>
                                        </label>
                                        <label class="ps-field ps-field--wide"><span>Note</span>
                                            <input type="text" class="ps-input" t-att-value="l.note" t-on-change="(ev) => this.setLineNote(l, ev.target.value)" placeholder="No sugar, gift wrap…"/>
                                        </label>
                                        <div class="ps-hook-line-edit"/>
                                        <button type="button" class="ps-link ps-link--danger" t-on-click="() => this.removeLine(l)"><i class="fa fa-trash-o" aria-hidden="true"/> Remove</button>
                                    </div>
                                </li>
                            </t>
                            <t t-foreach="extraLines" t-as="x" t-key="x.key">
                                <li class="ps-line ps-line--extra">
                                    <div class="ps-line-main">
                                        <span class="ps-line-img"><span class="ps-prod-ph ps-tone-teal"><i class="fa fa-gift" aria-hidden="true"/></span></span>
                                        <span class="ps-line-text">
                                            <span class="ps-line-name" t-esc="x.name"/>
                                            <span class="ps-line-price"><t t-if="x.free">Free</t><t t-else="" t-esc="money(x.total)"/></span>
                                            <span t-if="x.label" class="ps-line-label" t-esc="x.label"/>
                                        </span>
                                        <span class="ps-line-qty" t-esc="x.qty"/>
                                    </div>
                                </li>
                            </t>
                        </ul>

                        <div class="ps-cart-foot">
                            <div class="ps-cart-customer">
                                <PsCustomerPicker configId="d.config_id" value="state.partner" onSelect.bind="setPartner"/>
                            </div>
                            <div class="ps-hook-cart-foot"/>
                            <div t-if="cartLines.length" class="ps-row ps-row--tight">
                                <label class="ps-bill-discount ps-field ps-field--inline"><span>Bill discount %</span>
                                    <input type="number" min="0" max="100" step="0.5" inputmode="decimal" class="ps-input" t-att-value="state.billDiscount || ''" placeholder="0" t-on-change="(ev) => this.setBillDiscount(ev.target.value)"/>
                                </label>
                                <label class="ps-field ps-field--inline ps-field--grow"><span>Order note</span>
                                    <input type="text" class="ps-input" t-model="state.note" placeholder="Optional"/>
                                </label>
                            </div>
                            <dl class="ps-sum">
                                <div><dt>Subtotal</dt><dd t-esc="money(subtotal)"/></div>
                                <div t-if="discountAmount > 0" class="ps-sum-disc"><dt>Discount</dt><dd>−<t t-esc="money(discountAmount)"/></dd></div>
                                <div><dt>Tax</dt><dd t-esc="money(tax)"/></div>
                                <div t-if="rounding" class="ps-sum-muted"><dt>Rounding</dt><dd t-esc="money(rounding)"/></div>
                                <div class="ps-sum-total"><dt>Total</dt><dd t-esc="money(payable)"/></div>
                            </dl>
                            <div t-if="state.error" class="ps-error" t-esc="state.error"/>
                            <div class="ps-row">
                                <button type="button" class="ps-btn ps-btn--lg" t-att-disabled="!cartLines.length or state.busy" t-on-click="holdBill" title="Put the bill aside (F4)">
                                    <i class="fa fa-pause" aria-hidden="true"/> Hold
                                </button>
                                <button type="button" class="ps-btn ps-btn--primary ps-btn--lg ps-btn--grow"
                                        t-att-disabled="!cartLines.length or state.busy" t-on-click="enterPay">
                                    <t t-if="isRefund">Give back · <t t-esc="money(-payable)"/></t>
                                    <t t-else="">Pay<t t-if="cartLines.length"> · <t t-esc="money(payable)"/></t></t>
                                </button>
                            </div>
                        </div>
                    </t>
                </aside>
            </t>
        </div>
    </t>

    <t t-name="pos_modern.Tables">
        <div class="o_ps ps-tables">
            <t t-if="state.loading">
                <div class="ps-skel" style="height:3rem;width:18rem"/>
                <div class="ps-skel" style="height:24rem;margin-top:1rem"/>
            </t>
            <t t-else="">
                <header class="ps-pos-head">
                    <div class="ps-pos-title">
                        <h1>Tables</h1>
                        <div class="ps-pos-shop" t-if="state.shops.length">
                            <label class="ps-select">
                                <i class="fa fa-shopping-basket" aria-hidden="true"/>
                                <select t-on-change="onShop" aria-label="Shop">
                                    <t t-foreach="state.shops" t-as="s" t-key="s.id">
                                        <option t-att-value="s.id" t-att-selected="s.id === state.data.config_id" t-esc="s.name"/>
                                    </t>
                                </select>
                            </label>
                        </div>
                    </div>
                    <div class="ps-pos-actions">
                        <div class="ps-hook-tables-actions"/>
                        <button type="button" class="ps-btn" t-on-click="() => this.action.doAction('pos_modern.action_menu')"><i class="fa fa-cutlery" aria-hidden="true"/> Menu</button>
                    </div>
                </header>
                <div t-if="!state.data.installed or !state.data.floors.length" class="ps-pos-empty ps-pos-empty--inline">
                    <i class="fa fa-th" aria-hidden="true"/>
                    <strong>No table yet</strong>
                    <span>Turn on "Is a Bar/Restaurant" in the shop's settings and add floors and tables.</span>
                </div>
                <t t-else="">
                    <nav class="ps-floors" aria-label="Floors">
                        <t t-foreach="state.data.floors" t-as="f" t-key="f.id">
                            <button type="button" class="ps-floor" t-att-class="{ 'is-on': state.floorId === f.id }" t-on-click="() => this.state.floorId = f.id" t-esc="f.name"/>
                        </t>
                    </nav>
                    <div class="ps-table-grid">
                        <t t-foreach="floor ? floor.tables : []" t-as="t" t-key="t.id">
                            <button type="button" t-attf-class="ps-table ps-table--{{ t.shape }} {{ t.orders ? 'is-busy' : '' }}" t-on-click="() => this.openTable(t)">
                                <span class="ps-table-no" t-esc="t.number"/>
                                <span class="ps-table-seats"><i class="fa fa-user-o" aria-hidden="true"/> <t t-esc="t.seats"/></span>
                                <span class="ps-table-state">
                                    <t t-if="t.holds and t.holds.length"><t t-esc="money(t.holds[0].total)"/></t>
                                    <t t-elif="t.orders">Occupied</t>
                                    <t t-else="">Free</t>
                                </span>
                            </button>
                        </t>
                    </div>
                </t>
            </t>
        </div>
    </t>

</templates>
