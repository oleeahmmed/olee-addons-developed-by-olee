        <field name="path">modern-accounting-balance-sheet</field>
    </record>
    <record id="acct_action_tax_report" model="ir.actions.client">
        <field name="name">Tax Report</field>
        <field name="tag">invoice_modern.acct_tax_report</field>
        <field name="path">modern-accounting-tax-report</field>
    </record>
</odoo>
