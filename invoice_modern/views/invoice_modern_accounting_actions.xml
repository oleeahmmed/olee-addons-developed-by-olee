    </record>
    <record id="acct_action_trial_balance" model="ir.actions.client">
        <field name="name">Trial Balance</field>
        <field name="tag">invoice_modern.acct_trial_balance</field>
        <field name="path">modern-accounting-trial-balance</field>
    </record>
    <record id="acct_action_profit_loss" model="ir.actions.client">
        <field name="name">Profit &amp; Loss</field>
        <field name="tag">invoice_modern.acct_profit_loss</field>
