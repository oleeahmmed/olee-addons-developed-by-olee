<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One client action per accounting page; the pages are Odoo's own views (see static/src/js/pages). -->
    <record id="acct_action_entries" model="ir.actions.client">
        <field name="name">Journal Entries</field>
        <field name="tag">invoice_modern.acct_entries</field>
        <field name="path">modern-accounting-entries</field>
    </record>
    <record id="acct_action_items" model="ir.actions.client">
        <field name="name">Journal Items</field>
        <field name="tag">invoice_modern.acct_items</field>
        <field name="path">modern-accounting-items</field>
    </record>
    <record id="acct_action_payments" model="ir.actions.client">
        <field name="name">Payments</field>
        <field name="tag">invoice_modern.acct_payments</field>
        <field name="path">modern-accounting-payments</field>
    </record>
    <record id="acct_action_accounts" model="ir.actions.client">
        <field name="name">Chart of Accounts</field>
        <field name="tag">invoice_modern.acct_accounts</field>
        <field name="path">modern-accounting-accounts</field>
    </record>
    <record id="acct_action_general_ledger" model="ir.actions.client">
        <field name="name">General Ledger</field>
        <field name="tag">invoice_modern.acct_general_ledger</field>
