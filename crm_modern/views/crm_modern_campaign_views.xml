<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Campaign board used by Modern CRM only. Standalone kanban (no inherit_id),
        so Odoo's own UTM kanban stays untouched. Assign / upload / jump only work
        for users who can write the campaign or read leads.
    -->
    <record id="utm_campaign_kanban_modern" model="ir.ui.view">
        <field name="name">utm.campaign.kanban.modern</field>
        <field name="model">utm.campaign</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" default_group_by="stage_id" class="o_cm_campaign_kanban" sample="1">
                <field name="user_id"/>
                <field name="crm_modern_team_id"/>
                <field name="stage_id"/>
                <field name="active"/>
                <field name="title"/>
                <field name="crm_modern_lead_count"/>
                <field name="crm_modern_opportunity_count"/>
                <field name="crm_modern_open_count"/>
                <templates>
                    <t t-name="menu">
                        <t t-if="widget.editable"><a role="menuitem" type="open" class="dropdown-item">Edit</a></t>
                        <t t-if="widget.deletable"><a role="menuitem" type="delete" class="dropdown-item">Delete</a></t>
                        <a role="menuitem" class="dropdown-item" name="action_archive" type="object" t-if="record.active.raw_value">Archive</a>
                        <a role="menuitem" class="dropdown-item" name="action_unarchive" type="object" t-if="!record.active.raw_value">Restore</a>
                        <div role="separator" class="dropdown-divider"/>
                        <a role="menuitem" class="dropdown-item" name="crm_modern_open_leads" type="object" groups="crm.group_use_lead">Open leads</a>
                        <a role="menuitem" class="dropdown-item" name="crm_modern_open_pipeline" type="object">Open pipeline</a>
                        <div role="separator" class="dropdown-divider"/>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                        <div class="cm-cc-head">
                            <span class="cm-cc-logo"><i class="fa fa-bullhorn" title="Campaign"/></span>
                            <div class="cm-cc-titles">
                                <field name="title" class="cm-cc-title"/>
                                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" class="cm-cc-tags"/>
                            </div>
                        </div>
                        <div class="cm-kc-assign oe_kanban_action">
                            <div class="cm-kc-assign-item">
                                <span class="cm-kc-assign-label">Team</span>
                                <field name="crm_modern_team_id" widget="crm_modern_m2o_pick"
                                       options="{'placeholder': 'Assign team', 'icon': 'fa-users', 'searchPlaceholder': 'Search a team…'}"/>
                            </div>
                            <div class="cm-kc-assign-item">
                                <span class="cm-kc-assign-label">Person</span>
                                <field name="user_id" widget="crm_modern_user_pick"
                                       options="{'placeholder': 'Assign salesperson', 'searchPlaceholder': 'Search a salesperson…'}"
                                       domain="[('share', '=', False)]"/>
                            </div>
                        </div>
                        <div class="cm-cc-stats">
                            <button type="object" name="crm_modern_open_leads" class="cm-cc-stat" groups="crm.group_use_lead">
                                <strong><field name="crm_modern_lead_count"/></strong>
                                <span>Leads</span>
                            </button>
                            <button type="object" name="crm_modern_open_pipeline" class="cm-cc-stat">
                                <strong><field name="crm_modern_opportunity_count"/></strong>
                                <span>Opportunities</span>
                            </button>
                            <div class="cm-cc-stat">
                                <strong><field name="crm_modern_open_count"/></strong>
                                <span>Open</span>
                            </div>
                        </div>
                        <footer class="cm-cc-foot oe_kanban_action">
                            <widget name="crm_modern_campaign_actions"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="utm_campaign_view_form_modern" model="ir.ui.view">
        <field name="name">utm.campaign.form.modern</field>
        <field name="model">utm.campaign</field>
        <field name="inherit_id" ref="utm.utm_campaign_view_form"/>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="crm_modern_open_leads" type="object" class="oe_stat_button" icon="fa-user-plus" groups="crm.group_use_lead">
                    <field name="crm_modern_lead_count" widget="statinfo" string="Leads"/>
                </button>
                <button name="crm_modern_open_pipeline" type="object" class="oe_stat_button" icon="fa-briefcase">
                    <field name="crm_modern_opportunity_count" widget="statinfo" string="Opportunities"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="crm_modern_team_id" widget="crm_modern_m2o_pick"
                       options="{'placeholder': 'Assign sales team', 'icon': 'fa-users', 'searchPlaceholder': 'Search a team…'}"/>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="widget">crm_modern_user_pick</attribute>
                <attribute name="options">{'placeholder': 'Assign salesperson', 'searchPlaceholder': 'Search a salesperson…'}</attribute>
            </xpath>
            <xpath expr="//group[@id='top-group']" position="after">
                <div class="o_cm cm-cc-form-actions">
                    <widget name="crm_modern_campaign_actions"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
