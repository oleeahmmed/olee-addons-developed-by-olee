<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        No app of its own: everything lives inside Odoo's CRM app (crm.crm_menu_root).
        Home is a top-level page. Everyday work is two sidebar groups:
        CRM (Campaigns, Leads, Pipeline, Activities) and Sales (Quotations,
        Sales Orders, Customers, Dashboard). Team, Reporting and Configuration
        stay grouped for the top-bar dropdowns.
        Visibility comes from Odoo's groups (CRM app rights, CRM Settings).
    -->
    <menuitem id="menu_home" name="Home" parent="crm.crm_menu_root" action="action_home" sequence="-110"/>

    <menuitem id="menu_marketing" name="CRM" parent="crm.crm_menu_root" sequence="-100" groups="sales_team.group_sale_salesman" active="True"/>
    <menuitem id="menu_campaigns" name="Campaigns" parent="menu_marketing" action="action_campaigns" sequence="1" groups="sales_team.group_sale_salesman"/>
    <!-- Shown only when CRM ▸ Settings ▸ "Leads" is enabled, exactly like the standard CRM Leads menu. -->
    <menuitem id="menu_leads" name="Leads" parent="menu_marketing" action="action_leads" sequence="2" groups="crm.group_use_lead"/>
    <menuitem id="menu_pipeline" name="Pipeline" parent="menu_marketing" action="action_pipeline" sequence="3" groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_activities" name="Activities" parent="menu_marketing" action="action_activities" sequence="4" groups="sales_team.group_sale_salesman"/>

    <menuitem id="menu_sales" name="Sales" parent="crm.crm_menu_root" sequence="-90" groups="sales_team.group_sale_salesman" active="True"/>
    <menuitem id="menu_quotations" name="Quotations" parent="menu_sales" action="action_quotations" sequence="1" groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_sale_orders" name="Sales Orders" parent="menu_sales" action="action_sale_orders" sequence="2" groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_customers" name="Customers" parent="menu_sales" action="action_customers" sequence="3" groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_dashboard" name="Dashboard" parent="menu_sales" action="action_dashboard" sequence="4"/>

    <menuitem id="menu_users" name="Users" parent="crm.crm_menu_root" action="action_users" sequence="-80" groups="base.group_erp_manager"/>

    <menuitem id="menu_team" name="Team" parent="crm.crm_menu_root" sequence="-50" groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_teams" name="Sales Teams" parent="menu_team" action="action_teams" sequence="1"/>
    <menuitem id="menu_salespeople" name="Salespeople" parent="menu_team" action="action_salespeople" sequence="2"/>

    <!-- Odoo's own CRM reports (CRM Simple hides Odoo's Reporting menu, so they are linked here) -->
    <menuitem id="menu_reporting" name="Reporting" parent="crm.crm_menu_root" sequence="-60" groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_forecast" name="Forecast" parent="menu_reporting" action="crm.action_opportunity_forecast" sequence="1"/>
    <menuitem id="menu_report_pipeline" name="Pipeline Analysis" parent="menu_reporting" action="crm.crm_opportunity_report_action" sequence="2"/>
    <menuitem id="menu_report_leads" name="Leads Analysis" parent="menu_reporting" action="crm.crm_opportunity_report_action_lead" sequence="3" groups="crm.group_use_lead"/>
    <menuitem id="menu_report_activities" name="Activities Analysis" parent="menu_reporting" action="crm.crm_activity_report_action" sequence="4"/>

    <menuitem id="menu_config" name="Configuration" parent="crm.crm_menu_root" sequence="30" groups="sales_team.group_sale_manager"/>
    <menuitem id="menu_general_settings" name="General Settings" parent="menu_config" action="base_setup.action_general_configuration" sequence="0" groups="base.group_system"/>
    <menuitem id="menu_settings" name="CRM Settings" parent="menu_config" action="crm.crm_config_settings_action" sequence="1" groups="base.group_system"/>
    <menuitem id="menu_company" name="Company" parent="menu_config" action="action_company" sequence="2" groups="base.group_erp_manager"/>
    <menuitem id="menu_stages" name="Pipeline Stages" parent="menu_config" action="action_stages" sequence="3"/>
    <menuitem id="menu_activity_types" name="Activity Types" parent="menu_config" action="action_activity_types" sequence="4"/>
    <menuitem id="menu_activity_plans" name="Activity Plans" parent="menu_config" action="action_activity_plans" sequence="5"/>
    <menuitem id="menu_tags" name="Tags" parent="menu_config" action="action_tags" sequence="6"/>
    <menuitem id="menu_lost_reasons" name="Lost Reasons" parent="menu_config" action="action_lost_reasons" sequence="7"/>

    <function model="res.users" name="_crm_modern_set_default_home_action"/>
</odoo>
