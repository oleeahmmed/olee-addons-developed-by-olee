<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CRM Simple's campaign upload: "Add as Lead / Opportunity" only makes sense when
         CRM Settings > Leads is on. Without it the field is hidden and the wizard's
         default (opportunity) is used. Hooked on the field name, which is stable. -->
    <record id="simple_upload_wizard_form_lead_option" model="ir.ui.view">
        <field name="name">simple.upload.wizard.form.lead.option</field>
        <field name="model">simple.upload.wizard</field>
        <field name="inherit_id" ref="crm_simple.simple_upload_wizard_form"/>
        <field name="arch" type="xml">
            <field name="import_as" position="attributes">
                <attribute name="groups">crm.group_use_lead</attribute>
            </field>
        </field>
    </record>
</odoo>
