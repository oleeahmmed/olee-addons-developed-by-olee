<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="crm_modern.CampaignQuickActions">
        <div t-if="state.canRead or state.canCreate" class="o_cm cm-cq" t-on-click.stop="">
            <button t-if="state.canCreate" type="button" class="cm-btn cm-btn-primary cm-btn-sm" t-on-click="upload">
                <i class="fa fa-upload" aria-hidden="true"/> Upload CSV
            </button>
            <button t-if="state.useLeads and state.canRead" type="button" class="cm-btn cm-btn-outline cm-btn-sm"
                    t-on-click="openLeads">
                <i class="fa fa-user-plus" aria-hidden="true"/> Leads
            </button>
            <button t-if="state.canRead" type="button" class="cm-btn cm-btn-outline cm-btn-sm"
                    t-on-click="openPipeline">
                <i class="fa fa-briefcase" aria-hidden="true"/> Opportunities
            </button>
        </div>
    </t>

</templates>
