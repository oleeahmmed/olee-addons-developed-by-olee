<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="crm_modern.AreaChart">
        <figure class="cm-chart" style="margin:0">
            <svg t-attf-viewBox="0 0 {{ W }} {{ H }}" role="img" t-att-aria-label="props.label"
                 t-on-pointermove="onMove" t-on-pointerleave="() => this.state.hover = null">
                <defs>
                    <linearGradient id="cm-area-fill" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0%" stop-color="var(--cm-chart-1)" stop-opacity="0.22"/>
                        <stop offset="100%" stop-color="var(--cm-chart-1)" stop-opacity="0"/>
                    </linearGradient>
                </defs>
                <t t-foreach="ticks" t-as="tick" t-key="tick_index">
                    <line t-att-x1="P.l" t-att-x2="W - P.r" t-att-y1="y(tick)" t-att-y2="y(tick)"
                          stroke="var(--cm-border)" t-att-stroke-dasharray="tick ? '3 4' : undefined"/>
                    <text t-att-x="P.l - 8" t-att-y="y(tick)" dy="0.32em" text-anchor="end" font-size="10"
                          fill="var(--cm-muted-fg)" t-esc="props.formatAxis(tick)"/>
                </t>
                <t t-foreach="props.data" t-as="d" t-key="d_index">
                    <text t-att-x="x(d_index)" t-att-y="H - 6" text-anchor="middle" font-size="10" fill="var(--cm-muted-fg)" t-esc="d.label"/>
                </t>
                <path t-att-d="area" fill="url(#cm-area-fill)"/>
                <path t-att-d="line" fill="none" stroke="var(--cm-chart-1)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
                <t t-if="state.hover !== null">
                    <line t-att-x1="x(state.hover)" t-att-x2="x(state.hover)" t-att-y1="P.t" t-att-y2="H - P.b"
                          stroke="var(--cm-muted-fg)" stroke-opacity="0.4"/>
                    <circle t-att-cx="x(state.hover)" t-att-cy="y(props.data[state.hover].value)" r="5"
                            fill="var(--cm-chart-1)" stroke="var(--cm-card)" stroke-width="2"/>
                </t>
                <circle t-att-cx="x(last)" t-att-cy="y(props.data[last].value)" r="4" fill="var(--cm-chart-1)" stroke="var(--cm-card)" stroke-width="2"/>
            </svg>
            <div t-if="state.hover !== null" class="cm-tooltip" t-attf-style="left: {{ x(state.hover) / W * 100 }}%">
                <div class="cm-muted" t-esc="props.data[state.hover].label"/>
                <strong class="cm-tabular" t-esc="props.format(props.data[state.hover].value)"/>
            </div>
            <figcaption class="cm-sr-only" t-esc="summary"/>
        </figure>
    </t>

    <t t-name="crm_modern.BarList">
        <ul class="cm-barlist">
            <t t-foreach="props.items" t-as="item" t-key="item.id or item_index">
                <li t-att-title="item.label + ': ' + props.format(item.value)">
                    <div class="cm-bar-meta">
                        <span class="cm-truncate" style="font-weight:500">
                            <t t-esc="item.label"/>
                            <span t-if="item.sub" class="cm-muted" style="font-weight:400;margin-left:0.375rem" t-esc="item.sub"/>
                        </span>
                        <span class="cm-muted cm-tabular" style="flex-shrink:0" t-esc="props.format(item.value)"/>
                    </div>
                    <div class="cm-bar"><span t-attf-style="width: {{ width(item.value) }}%"/></div>
                </li>
            </t>
        </ul>
    </t>

    <t t-name="crm_modern.TagInput">
        <div class="position-relative" t-ref="root">
            <div class="or-input cm-input d-flex flex-wrap align-items-center" style="height:auto;min-height:2.5rem;padding:0.35rem 0.75rem;gap:0.25rem;cursor:text"
                 t-on-click="focusInput">
                <TagChips tags="props.value" onRemove.bind="remove"/>
                <input t-att-id="props.id" role="combobox" t-att-aria-expanded="state.open ? 'true' : 'false'" aria-autocomplete="list"
                       class="border-0 bg-transparent" style="flex:1;min-width:6rem;height:1.5rem;outline:none;font-size:0.875rem;color:inherit"
                       t-att-placeholder="props.value.length ? '' : (props.placeholder or 'Add tags…')"
                       t-model="state.q" t-on-focus="() => this.state.open = true"
                       t-on-input="onInput"
                       t-on-keydown="onKeydown"/>
            </div>
            <ul t-if="state.open and options.length" role="listbox" class="cm-card position-absolute w-100 p-1"
                style="z-index:1060;top:100%;left:0;margin:0.25rem 0 0;max-height:15rem;overflow:auto;list-style:none;box-shadow:var(--cm-shadow-lg)">
                <t t-foreach="options" t-as="opt" t-key="opt.id">
                    <li role="option" t-att-aria-selected="opt_index === state.active ? 'true' : 'false'">
                        <button type="button" class="d-flex align-items-center w-100 border-0 text-start"
                                t-attf-style="gap:0.5rem;padding:0.375rem 0.5rem;border-radius:0.375rem;font-size:0.875rem;color:inherit;background:{{ opt_index === state.active ? 'var(--cm-muted)' : 'transparent' }}"
                                t-on-mouseenter="() => this.state.active = opt_index"
                                t-on-mousedown.prevent="noop" t-on-click="() => this.pick(opt_index)">
                            <t t-if="opt.kind === 'create'">
                                <i class="fa fa-plus" style="color:var(--cm-primary)" aria-hidden="true"/> Create <strong>“<t t-esc="opt.name"/>”</strong>
                            </t>
                            <t t-else="">
                                <span t-attf-class="cm-tag cm-tag-{{ opt.color or 0 }}" style="width:0.625rem;height:0.625rem;padding:0"/>
                                <t t-esc="opt.name"/>
                            </t>
                        </button>
                    </li>
                </t>
            </ul>
        </div>
    </t>

</templates>
