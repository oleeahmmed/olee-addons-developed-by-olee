<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="crm_modern.Activities">
        <div class="o_cm o_cm_page">
            <div class="cm-container">
                <PageHeader title="'Activities'" description="'Every scheduled call, meeting, email and to-do on your leads and opportunities.'"/>

                <div class="cm-grid-stats">
                    <t t-foreach="groups" t-as="g" t-key="g.key">
                        <div class="cm-card d-flex align-items-center u-gap-0_75 u-p-1">
                            <i class="u-fs-1_25" t-attf-class="fa {{ g.icon }} cm-due-{{ g.key }}" aria-hidden="true"/>
                            <div>
                                <div class="cm-tabular u-fs-1_25 u-fw-600" t-esc="count(g.key)"/>
                                <div class="cm-muted od-text-xs" t-esc="g.label"/>
                            </div>
                        </div>
                    </t>
                    <div class="cm-card d-flex align-items-center u-gap-0_75 u-p-1">
                        <i class="fa fa-list u-fs-1_25 u-c-cm-primary" aria-hidden="true"/>
                        <div>
                            <div class="cm-tabular u-fs-1_25 u-fw-600" t-esc="state.items.length"/>
                            <div class="cm-muted od-text-xs">Total open</div>
                        </div>
                    </div>
                </div>

                <div class="cm-toolbar">
                    <select class="cm-select u-w-13" aria-label="Filter by activity type" t-on-change="(ev) => this.setFilter('type', ev.target.value)">
                        <option value="">All activity types</option>
                        <t t-foreach="typeList" t-as="t" t-key="t.id"><option t-att-value="t.id" t-esc="t.name"/></t>
                    </select>
                    <select class="cm-select u-w-12" aria-label="Filter by assignee" t-on-change="(ev) => this.setFilter('who', ev.target.value)">
                        <option value="">Everyone</option>
                        <t t-foreach="state.users" t-as="u" t-key="u.id"><option t-att-value="u.id" t-att-selected="('' + u.id) === state.who" t-esc="u.name"/></t>
                    </select>
                </div>

                <div t-if="state.loading" class="cm-skeleton u-h-16"/>
                <div t-elif="!state.items.length" class="cm-card">
                    <EmptyState icon="'fa-calendar-check-o'" title="'All caught up'" description="'No open activities match these filters.'"/>
                </div>
                <t t-else="">
                    <t t-foreach="groups" t-as="g" t-key="g.key">
                        <section t-if="count(g.key)" t-attf-aria-labelledby="cm_grp_{{ g.key }}" class="d-grid u-gap-0_5">
                            <h2 class="u-gap-0_5 u-fs-0_875 u-fw-600" t-attf-id="cm_grp_{{ g.key }}" t-attf-class="cm-due-{{ g.key }} m-0 d-flex align-items-center">
                                <i t-attf-class="fa {{ g.icon }}" aria-hidden="true"/><t t-esc="g.label"/>
                                <span class="cm-muted cm-tabular u-fw-400">(<t t-esc="count(g.key)"/>)</span>
                            </h2>
                            <div class="cm-card">
                                <ul class="list-unstyled m-0 cm-divide-y">
                                    <t t-foreach="itemsOf(g.key)" t-as="a" t-key="a.id">
                                        <li class="d-flex flex-wrap align-items-center u-gap-0_75 u-p-0_75-1">
                                            <ActivityIcon type="state.types[a.activity_type_id[0]]"/>
                                            <div class="cm-truncate u-flex-1 u-minw-14">
                                                <div class="cm-truncate u-fw-500" t-esc="a.summary or a.activity_type_id[1]"/>
                                                <a class="cm-row-link cm-muted cm-truncate d-block od-text-xs" t-on-click="() => this.lead.open(a.res_id)">
                                                    <t t-esc="a.res_name"/> · <t t-esc="a.activity_type_id[1]"/>
                                                </a>
                                            </div>
                                            <div class="text-end">
                                                <div class="od-text-xs" t-esc="shortDate(a.date_deadline)"/>
                                                <DueLabel date="a.date_deadline"/>
                                            </div>
                                            <Avatar id="a.user_id and a.user_id[0]" name="a.user_id and a.user_id[1]" size="'sm'"/>
                                            <div class="d-flex align-items-center u-gap-0_25">
                                                <button class="cm-btn cm-btn-outline cm-btn-sm" t-on-click="() => this.activity.markDone(a, state.types[a.activity_type_id[0]])">
                                                    <i class="fa fa-check" aria-hidden="true"/> Done
                                                </button>
                                                <button class="cm-btn cm-btn-ghost cm-btn-icon cm-btn-sm" aria-label="Edit activity" title="Edit" t-on-click="() => this.activity.edit(a.id)">
                                                    <i class="fa fa-pencil" aria-hidden="true"/>
                                                </button>
                                                <button class="cm-btn cm-btn-danger-ghost cm-btn-icon cm-btn-sm" aria-label="Cancel activity" title="Cancel" t-on-click="() => this.activity.cancel(a.id)">
                                                    <i class="fa fa-times" aria-hidden="true"/>
                                                </button>
                                            </div>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </section>
                    </t>
                </t>
            </div>
        </div>
    </t>

</templates>
