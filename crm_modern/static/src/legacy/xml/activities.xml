<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="crm_modern.Activities">
        <div class="o_cm o_cm_page">
            <div class="cm-container">
                <PageHeader title="'Activities'" description="'Every scheduled call, meeting, email and to-do on your leads and opportunities.'"/>

                <div class="cm-grid-stats">
                    <t t-foreach="groups" t-as="g" t-key="g.key">
                        <div class="cm-card d-flex align-items-center" style="gap:0.75rem;padding:1rem">
                            <i t-attf-class="fa {{ g.icon }} cm-due-{{ g.key }}" style="font-size:1.25rem" aria-hidden="true"/>
                            <div>
                                <div class="cm-tabular" style="font-size:1.25rem;font-weight:600" t-esc="count(g.key)"/>
                                <div class="cm-muted" style="font-size:0.75rem" t-esc="g.label"/>
                            </div>
                        </div>
                    </t>
                    <div class="cm-card d-flex align-items-center" style="gap:0.75rem;padding:1rem">
                        <i class="fa fa-list" style="font-size:1.25rem;color:var(--cm-primary)" aria-hidden="true"/>
                        <div>
                            <div class="cm-tabular" style="font-size:1.25rem;font-weight:600" t-esc="state.items.length"/>
                            <div class="cm-muted" style="font-size:0.75rem">Total open</div>
                        </div>
                    </div>
                </div>

                <div class="cm-toolbar">
                    <select class="cm-select" style="width:13rem" aria-label="Filter by activity type" t-on-change="(ev) => this.setFilter('type', ev.target.value)">
                        <option value="">All activity types</option>
                        <t t-foreach="typeList" t-as="t" t-key="t.id"><option t-att-value="t.id" t-esc="t.name"/></t>
                    </select>
                    <select class="cm-select" style="width:12rem" aria-label="Filter by assignee" t-on-change="(ev) => this.setFilter('who', ev.target.value)">
                        <option value="">Everyone</option>
                        <t t-foreach="state.users" t-as="u" t-key="u.id"><option t-att-value="u.id" t-att-selected="('' + u.id) === state.who" t-esc="u.name"/></t>
                    </select>
                </div>

                <div t-if="state.loading" class="cm-skeleton" style="height:16rem"/>
                <div t-elif="!state.items.length" class="cm-card">
                    <EmptyState icon="'fa-calendar-check-o'" title="'All caught up'" description="'No open activities match these filters.'"/>
                </div>
                <t t-else="">
                    <t t-foreach="groups" t-as="g" t-key="g.key">
                        <section t-if="count(g.key)" t-attf-aria-labelledby="cm_grp_{{ g.key }}" class="d-grid" style="gap:0.5rem">
                            <h2 t-attf-id="cm_grp_{{ g.key }}" t-attf-class="cm-due-{{ g.key }} m-0 d-flex align-items-center" style="gap:0.5rem;font-size:0.875rem;font-weight:600">
                                <i t-attf-class="fa {{ g.icon }}" aria-hidden="true"/><t t-esc="g.label"/>
                                <span class="cm-muted cm-tabular" style="font-weight:400">(<t t-esc="count(g.key)"/>)</span>
                            </h2>
                            <div class="cm-card">
                                <ul class="list-unstyled m-0 cm-divide-y">
                                    <t t-foreach="itemsOf(g.key)" t-as="a" t-key="a.id">
                                        <li class="d-flex flex-wrap align-items-center" style="gap:0.75rem;padding:0.75rem 1rem">
                                            <ActivityIcon type="state.types[a.activity_type_id[0]]"/>
                                            <div class="cm-truncate" style="flex:1;min-width:14rem">
                                                <div class="cm-truncate" style="font-weight:500" t-esc="a.summary or a.activity_type_id[1]"/>
                                                <a class="cm-row-link cm-muted cm-truncate d-block" style="font-size:0.75rem" t-on-click="() => this.lead.open(a.res_id)">
                                                    <t t-esc="a.res_name"/> · <t t-esc="a.activity_type_id[1]"/>
                                                </a>
                                            </div>
                                            <div class="text-end">
                                                <div style="font-size:0.75rem" t-esc="shortDate(a.date_deadline)"/>
                                                <DueLabel date="a.date_deadline"/>
                                            </div>
                                            <Avatar id="a.user_id and a.user_id[0]" name="a.user_id and a.user_id[1]" size="'sm'"/>
                                            <div class="d-flex align-items-center" style="gap:0.25rem">
                                                <button class="cm-btn cm-btn-outline cm-btn-sm" t-on-click="() => this.activity.markDone(a, state.types[a.activity_type_id[0]])">
                                                    <i class="fa fa-check" aria-hidden="true"/> Done
                                                </button>
                                                <button class="cm-btn cm-btn-ghost cm-btn-icon cm-btn-sm" aria-label="Edit activity" title="Edit" t-on-click="() => this.activity.edit(a.id)">
                                                    <i class="fa fa-pencil" aria-hidden="true"/>
                                                </button>
                                                <button class="cm-btn cm-btn-danger-ghost cm-btn-icon cm-btn-sm" aria-label="Cancel activity" title="Cancel" t-on-click="() => this.activity.cancel(a.id)">
                                                    <i class="fa fa-times" aria-hidden="true"/>
                                                </button>
                                            </div>
                                        </li>
                                    </t>
                                </ul>
                            </div>
                        </section>
                    </t>
                </t>
            </div>
        </div>
    </t>

</templates>
