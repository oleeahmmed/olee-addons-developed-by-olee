<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="modern_inventory.PageHeader">
        <div class="im-page-header">
            <div class="im-truncate">
                <button t-if="props.crumb" type="button" class="im-crumb" t-on-click="props.crumb.onClick">
                    <i class="fa fa-arrow-left" aria-hidden="true"/> <t t-esc="props.crumb.label"/>
                </button>
                <h1 class="im-truncate" t-esc="props.title"/>
                <p t-if="props.description" t-esc="props.description"/>
            </div>
            <div t-if="props.slots and props.slots.actions" class="im-actions">
                <t t-slot="actions"/>
            </div>
        </div>
    </t>

    <t t-name="modern_inventory.StatCard">
        <div class="im-card im-stat">
            <div class="im-stat-top">
                <span class="im-stat-label" t-esc="props.label"/>
                <span class="im-stat-icon" aria-hidden="true"><i t-attf-class="fa {{ props.icon }}"/></span>
            </div>
            <div class="im-stat-value" t-esc="props.value"/>
            <div t-if="props.hint" class="im-stat-hint" t-esc="props.hint"/>
        </div>
    </t>

    <t t-name="modern_inventory.Segmented">
        <div class="im-seg" role="radiogroup" t-att-aria-label="props.label">
            <t t-foreach="props.options" t-as="opt" t-key="opt_index">
                <button type="button" role="radio" t-att-aria-checked="opt.value === props.value ? 'true' : 'false'"
                        t-on-click="() => props.onChange(opt.value)">
                    <t t-esc="opt.label"/>
                    <span t-if="opt.count !== undefined" class="im-count im-tabular" t-esc="opt.count"/>
                </button>
            </t>
        </div>
    </t>

    <t t-name="modern_inventory.Stars">
        <span class="im-stars" t-att-role="props.onChange ? 'radiogroup' : undefined" aria-label="Priority">
            <t t-foreach="[1, 2, 3]" t-as="n" t-key="n">
                <button t-if="props.onChange" type="button" role="radio" t-att-aria-checked="level === n ? 'true' : 'false'"
                        t-attf-aria-label="{{ n }} star priority" t-att-class="{ 'im-on': n &lt;= level }"
                        t-on-click.stop="() => this.set(n)">
                    <i t-attf-class="fa {{ n &lt;= level ? 'fa-star' : 'fa-star-o' }}" aria-hidden="true"/>
                </button>
                <span t-else="" t-att-class="{ 'im-on': n &lt;= level }" aria-hidden="true">
                    <i t-attf-class="fa {{ n &lt;= level ? 'fa-star' : 'fa-star-o' }}"/>
                </span>
            </t>
        </span>
    </t>

    <t t-name="modern_inventory.TagChips">
        <span t-if="props.tags.length" class="im-tag-list">
            <t t-foreach="shown" t-as="tag" t-key="tag.id">
                <span t-attf-class="im-tag im-tag-{{ tag.color or 0 }}">
                    <t t-esc="tag.name"/>
                    <button t-if="props.onRemove" type="button" t-attf-aria-label="Remove tag {{ tag.name }}"
                            t-on-click.stop="() => props.onRemove(tag.id)"><i class="fa fa-times" aria-hidden="true"/></button>
                </span>
            </t>
            <span t-if="props.max and props.tags.length > props.max" class="im-tag">+<t t-esc="props.tags.length - props.max"/></span>
        </span>
    </t>

    <t t-name="modern_inventory.ActivityIcon">
        <span t-attf-class="im-act-icon {{ tone }} {{ props.small ? 'im-act-sm' : '' }}" aria-hidden="true">
            <i t-attf-class="fa {{ icon }}"/>
        </span>
    </t>

    <t t-name="modern_inventory.DueLabel">
        <span t-if="info.label" t-attf-class="im-due-{{ info.state }}" style="font-size:0.75rem;font-weight:500" t-esc="info.label"/>
    </t>

    <t t-name="modern_inventory.Avatar">
        <img t-if="props.id" t-att-src="src" t-att-alt="props.name or ''" t-att-title="props.name or ''" loading="lazy"
             t-attf-class="im-avatar {{ props.size ? 'im-avatar-' + props.size : '' }}"/>
        <span t-else="" t-attf-class="im-avatar im-avatar-empty {{ props.size ? 'im-avatar-' + props.size : '' }}" title="Unassigned" aria-label="Unassigned">
            <i class="fa fa-user-o" aria-hidden="true"/>
        </span>
    </t>

    <t t-name="modern_inventory.EmptyState">
        <div class="im-empty">
            <span class="im-empty-icon" aria-hidden="true"><i t-attf-class="fa {{ props.icon }}"/></span>
            <strong t-esc="props.title"/>
            <p t-if="props.description" t-esc="props.description"/>
            <div t-if="props.slots and props.slots.default" style="margin-top:0.5rem"><t t-slot="default"/></div>
        </div>
    </t>

    <t t-name="modern_inventory.Progress">
        <div t-attf-class="im-progress {{ props.tone ? 'im-progress-' + props.tone : '' }}" role="progressbar"
             t-att-aria-label="props.label" t-att-aria-valuenow="Math.round(pct)" aria-valuemin="0" aria-valuemax="100">
            <span t-attf-style="width: {{ pct }}%"/>
        </div>
    </t>

</templates>
