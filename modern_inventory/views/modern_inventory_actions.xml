<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One client action per page; each page embeds Odoo's own views of the same records. -->
    <record id="action_dashboard" model="ir.actions.client">
        <field name="name">Inventory Dashboard</field>
        <field name="tag">modern_inventory.dashboard</field>
        <field name="path">modern-inventory</field>
    </record>
    <record id="action_receipts" model="ir.actions.client">
        <field name="name">Receipts</field>
        <field name="tag">modern_inventory.receipts</field>
        <field name="path">modern-inventory-receipts</field>
    </record>
    <record id="action_deliveries" model="ir.actions.client">
        <field name="name">Deliveries</field>
        <field name="tag">modern_inventory.deliveries</field>
        <field name="path">modern-inventory-deliveries</field>
    </record>
    <record id="action_internal" model="ir.actions.client">
        <field name="name">Internal Transfers</field>
        <field name="tag">modern_inventory.internal</field>
        <field name="path">modern-inventory-internal</field>
    </record>
    <record id="action_products" model="ir.actions.client">
        <field name="name">Products</field>
        <field name="tag">modern_inventory.products</field>
        <field name="path">modern-inventory-products</field>
    </record>
    <record id="action_stock" model="ir.actions.client">
        <field name="name">Stock on Hand</field>
        <field name="tag">modern_inventory.stock</field>
        <field name="path">modern-inventory-stock</field>
    </record>
    <record id="action_moves" model="ir.actions.client">
        <field name="name">Moves History</field>
        <field name="tag">modern_inventory.moves</field>
        <field name="path">modern-inventory-moves</field>
    </record>
</odoo>
