<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ============================================================ Attendances -->
    <t t-name="attendance_modern.Dashboard">
        <div class="o_em od-page">
            <t t-set="appName" t-value="'Attendances'"/>
            <t t-call="employee_modern.TimeDashboardState"/>
            <t t-if="!state.loading and state.data and state.data.installed">
                <t t-set="d" t-value="state.data"/>
                <header class="od-head">
                    <div>
                        <div class="od-eyebrow"><span class="od-live" aria-hidden="true"/> <t t-esc="d.company"/> · Attendance overview</div>
                        <h1 class="od-title"><t t-esc="greeting"/>, <t t-esc="firstName"/></h1>
                        <p class="od-subtitle">
                            Who is at work now · hours worked <strong t-esc="caption.current"/>, compared with <t t-esc="caption.previous"/>
                        </p>
                    </div>
                    <div class="od-head-actions">
                        <OdFilters period="state.period" teamId="state.teamId" teams="departments" onChange.bind="onFilters" busy="state.busy"
                                   allLabel="'All departments'" icon="'fa-sitemap'" label="'Department'"/>
                        <button type="button" class="od-btn od-btn--icon" title="Refresh" aria-label="Refresh" t-on-click="() => this.load()">
                            <i t-attf-class="fa fa-refresh {{ state.busy ? 'fa-spin' : '' }}" aria-hidden="true"/>
                        </button>
                        <button type="button" class="od-btn od-btn--primary" data-hotkey="c" t-on-click="newAttendance">
                            <i class="fa fa-plus" aria-hidden="true"/> New attendance
                        </button>
                    </div>
                </header>

                <div t-att-class="{ 'od-busy': state.busy }">
                    <section class="od-kpis" aria-label="Key figures">
                        <OdKpi featured="true" tone="'teal'" icon="'fa-sign-in'" label="'At work now'" value="count(k.at_work)"
                               hint="'checked in, not checked out yet'" onClick="() => this.openPresence({ key: 'at_work' })"/>
                        <OdKpi tone="'blue'" icon="'fa-check'" label="'Checked in today'" value="count(k.checked_today)"
                               hint="'of ' + count(k.headcount) + ' employees'" onClick="() => this.openPresence({ key: 'checked', label: 'Checked in today' })"/>
                        <OdKpi tone="'amber'" icon="'fa-user-times'" label="'Not checked in'" value="count(k.not_checked)"
                               hint="'today, so far'" invert="true" onClick="() => this.openPresence({ key: 'absent', label: 'Not checked in today' })"/>
                        <OdKpi tone="'sky'" icon="'fa-clock-o'" label="'Hours worked'" value="hours(k.hours)"
                               delta="k.hours_delta" compareLabel="compare" spark="d.spark"
                               hint="hours(k.hours_prev) + ' in the previous period'" onClick="() => this.go('attendance_modern.action_attendances')"/>
                        <OdKpi tone="'slate'" icon="'fa-hourglass-half'" label="'Average day'" value="hours(k.avg_day)"
                               hint="'per employee, per day worked'"/>
                        <OdKpi tone="'violet'" icon="'fa-bolt'" label="'Extra hours'" value="hours(k.overtime)"
                               hint="count(k.overtime_to_approve) + ' to approve'" onClick="() => this.go('attendance_modern.action_extra_hours')"/>
                    </section>

                    <div class="od-grid">
                        <section class="od-card od-span-8">
                            <div class="od-card-head">
                                <div>
                                    <h3><span class="od-card-icon od-tone-blue"><i class="fa fa-bar-chart" aria-hidden="true"/></span> Hours worked, last 14 days</h3>
                                    <p>Per day, with the 14 days before for comparison</p>
                                </div>
                                <div class="od-card-total"><strong class="od-num" t-esc="hours(total14)"/><span>in 14 days</span></div>
                            </div>
                            <div class="od-card-body">
                                <OdComboChart data="d.days" format="hours" formatAxis="axis" currentLabel="'Last 14 days'" previousLabel="'14 days before'"
                                              label="'Hours worked per day over the last 14 days'"/>
                            </div>
                        </section>
                        <section class="od-card od-span-4">
                            <div class="od-card-head"><div>
                                <h3><span class="od-card-icon od-tone-rose"><i class="fa fa-bell-o" aria-hidden="true"/></span> Needs your attention</h3>
                                <p>Click a line to see the attendances</p>
                            </div></div>
                            <div class="od-card-body">
                                <OdAttention items="d.attention" format="count" onClick.bind="openAttention"/>
                            </div>
                        </section>
                    </div>

                    <div class="od-grid">
                        <section class="od-card od-span-4">
                            <div class="od-card-head">
                                <div>
                                    <h3><span class="od-card-icon od-tone-teal"><i class="fa fa-sign-in" aria-hidden="true"/></span> At work now</h3>
                                    <p>Checked in, not checked out yet</p>
                                </div>
                                <button type="button" class="od-link" t-on-click="() => this.go('attendance_modern.action_at_work')">All <i class="fa fa-angle-right" aria-hidden="true"/></button>
                            </div>
                            <div class="od-card-body">
                                <div t-if="!atWorkFeed.length" class="od-empty"><i class="fa fa-moon-o" aria-hidden="true"/><strong>Nobody is checked in</strong></div>
                                <OdFeed t-else="" items="atWorkFeed" onClick.bind="openAttendance"/>
                            </div>
                        </section>
                        <section class="od-card od-span-4">
                            <div class="od-card-head"><div>
                                <h3><span class="od-card-icon od-tone-blue"><i class="fa fa-sitemap" aria-hidden="true"/></span> By department</h3>
                                <p>Hours worked in this period</p>
                            </div></div>
                            <div class="od-card-body">
                                <div t-if="!d.by_department.length" class="od-empty"><i class="fa fa-sitemap" aria-hidden="true"/><strong>No hours in this period</strong></div>
                                <OdRank t-else="" items="d.by_department" format="hours" tone="'blue'" onClick.bind="openDepartment"/>
                            </div>
                        </section>
                        <section class="od-card od-span-4">
                            <div class="od-card-head"><div>
                                <h3><span class="od-card-icon od-tone-violet"><i class="fa fa-bolt" aria-hidden="true"/></span> Most extra hours</h3>
                                <p>In this period</p>
                            </div></div>
                            <div class="od-card-body">
                                <div t-if="!d.top_overtime.length" class="od-empty"><i class="fa fa-check-circle-o" aria-hidden="true"/><strong>No extra hours</strong></div>
                                <OdRank t-else="" items="d.top_overtime" format="hours" tone="'violet'" numbered="true" onClick.bind="openEmployeeOvertime"/>
                            </div>
                        </section>
                    </div>

                    <section class="od-card">
                        <div class="od-card-head">
                            <div>
                                <h3>Latest attendances</h3>
                                <p>Most recent check-ins · click one to open it</p>
                            </div>
                            <button type="button" class="od-link" t-on-click="() => this.go('attendance_modern.action_attendances')">All attendances <i class="fa fa-angle-right" aria-hidden="true"/></button>
                        </div>
                        <div class="od-card-body od-card-body--flush">
                            <OdTable columns="attendanceColumns" rows="attendanceRows" pageSize="8" unit="'attendances'" onRowClick.bind="openAttendance" emptyText="'No attendance yet'"/>
                        </div>
                    </section>
                </div>
            </t>
        </div>
    </t>

</templates>
