<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Inside Odoo's Attendances app. Sidebar: At Work, Attendances, Extra Hours.
        Odoo's "Management" entry is replaced in the sidebar by these (static/src/js/sidebar.js);
        Odoo's Overview stays, Kiosk Mode, Reporting and Configuration go to the top bar.
    -->
    <menuitem id="attendance_menu_at_work" name="At Work" parent="hr_attendance.menu_hr_attendance_root"
              action="attendance_action_at_work" sequence="-95" groups="hr_attendance.group_hr_attendance_officer"/>
    <menuitem id="attendance_menu_attendances" name="Attendances" parent="hr_attendance.menu_hr_attendance_root"
              action="attendance_action_attendances" sequence="-90" groups="hr_attendance.group_hr_attendance_officer"/>
    <menuitem id="attendance_menu_extra_hours" name="Extra Hours" parent="hr_attendance.menu_hr_attendance_root"
              action="attendance_action_extra_hours" sequence="-85" groups="hr_attendance.group_hr_attendance_officer"/>
</odoo>
