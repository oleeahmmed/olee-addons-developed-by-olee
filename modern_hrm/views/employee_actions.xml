<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Client actions of Modern Employees: each one shows Odoo's own views of the
         standard HR models inside the shared modern page (see static/src/js/pages). -->
    <record id="employee_action_dashboard" model="ir.actions.client">
        <field name="name">People Dashboard</field>
        <field name="tag">modern_hrm.employee_dashboard</field>
        <field name="path">modern-employees</field>
    </record>
    <record id="employee_action_employees" model="ir.actions.client">
        <field name="name">Employees</field>
        <field name="tag">modern_hrm.employee_employees</field>
        <field name="path">modern-employees-all</field>
    </record>
    <record id="employee_action_departments" model="ir.actions.client">
        <field name="name">Departments</field>
        <field name="tag">modern_hrm.employee_departments</field>
        <field name="path">modern-employees-departments</field>
    </record>
    <record id="employee_action_jobs" model="ir.actions.client">
        <field name="name">Job Positions</field>
        <field name="tag">modern_hrm.employee_jobs</field>
        <field name="path">modern-employees-jobs</field>
    </record>
    <record id="employee_action_new_hires" model="ir.actions.client">
        <field name="name">New Hires</field>
        <field name="tag">modern_hrm.employee_new_hires</field>
        <field name="path">modern-employees-new</field>
    </record>
    <record id="employee_action_contracts_ending" model="ir.actions.client">
        <field name="name">Contracts Ending</field>
        <field name="tag">modern_hrm.employee_contracts_ending</field>
        <field name="path">modern-employees-ending</field>
    </record>
    <record id="employee_action_former" model="ir.actions.client">
        <field name="name">Former Employees</field>
        <field name="tag">modern_hrm.employee_former</field>
        <field name="path">modern-employees-former</field>
    </record>
    <record id="employee_action_records" model="ir.actions.client">
        <field name="name">Employee History</field>
        <field name="tag">modern_hrm.employee_records</field>
        <field name="path">modern-employees-history</field>
    </record>
</odoo>
