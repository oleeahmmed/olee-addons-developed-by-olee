<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo Community hides its full accounting features (journal entries, journal items,
        chart of accounts…) behind "Show Full Accounting Features". Like Odoo's own
        Accounting app, installing this addon turns them on for Invoicing administrators.
        Only an implication between two of Odoo's own groups: no new group, no new right.
        Bookkeepers who are not administrators get them from their user form
        ("Show Full Accounting Features" / "Readonly"), as in standard Odoo.
    -->
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('account.group_account_user'))]"/>
    </record>
</odoo>
