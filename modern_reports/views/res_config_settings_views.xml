<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.modern_reports</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Modern Reports" id="modern_reports_settings">
                    <setting id="mr_accent_color" string="Document accent colour"
                             help="Title band, table header and totals colour on invoices, quotations and orders.">
                        <field name="mr_accent_color" widget="color"/>
                    </setting>
                    <setting id="mr_payment_methods" string="Payment methods"
                             help="Bank, mobile wallet and cash cards printed on customer documents.">
                        <button name="action_mr_payment_methods" type="object" string="Payment Methods"
                                class="btn-link" icon="oi-arrow-right"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
