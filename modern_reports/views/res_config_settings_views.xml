<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.modern_reports</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block title="Modern Reports" id="modern_reports_settings">
                    <setting id="mr_colors" string="Document colours"
                             help="Title band, table header, captions and total on invoices, quotations and orders.">
                        <field name="mr_color_source" widget="radio"/>
                        <div invisible="mr_color_source != 'custom'" class="mt-2">
                            <field name="mr_accent_color" widget="color"/>
                        </div>
                        <div invisible="mr_color_source != 'document'" class="mt-2">
                            <button name="%(web.action_base_document_layout_configurator)d" type="action"
                                    string="Configure Document Layout" class="btn-link" icon="oi-arrow-right"/>
                        </div>
                    </setting>
                    <setting id="mr_background" string="Document background"
                             help="Background behind the printed page. The font always follows the Document Layout font.">
                        <field name="mr_background" widget="radio"/>
                    </setting>
                    <setting id="mr_fill_page" string="Fill page with item rows"
                             help="Empty rows fill the item table so the totals, payment details and signatures always sit at the bottom of the last page.">
                        <field name="mr_fill_page"/>
                    </setting>
                    <setting id="mr_show_signatures" string="Signature lines"
                             help="Print customer / authorised signatory lines at the bottom.">
                        <field name="mr_show_signatures"/>
                    </setting>
                    <setting id="mr_payment_methods" string="Payment methods"
                             help="Bank, mobile wallet and cash cards printed on customer documents.">
                        <field name="mr_show_payment_methods"/>
                        <div invisible="not mr_show_payment_methods">
                            <button name="action_mr_payment_methods" type="object" string="Payment Methods"
                                    class="btn-link" icon="oi-arrow-right"/>
                        </div>
                    </setting>
                </block>
                <block title="Modern Reports: print design" id="modern_reports_design"
                       help="Same design for invoices, bills, quotations, sales and purchase orders and delivery slips.">
                    <setting id="mr_table_style" string="Item table borders"
                             help="Lines of the product table.">
                        <field name="mr_table_style" widget="radio"/>
                    </setting>
                    <setting id="mr_table_header" string="Item table header"
                             help="Fill of the product table's header row.">
                        <field name="mr_table_header" widget="radio"/>
                    </setting>
                    <setting id="mr_title_style" string="Document title"
                             help="The band under the header (Sales Invoice, Quotation, Delivery Slip…).">
                        <field name="mr_title_style" widget="radio"/>
                    </setting>
                    <setting id="mr_density" string="Row spacing"
                             help="Padding of the item, totals and information rows.">
                        <field name="mr_density" widget="radio"/>
                    </setting>
                    <setting id="mr_font_size" string="Text size">
                        <field name="mr_font_size" widget="radio"/>
                    </setting>
                    <setting id="mr_frame" string="Frame around the page"
                             help="A thin border around the whole document.">
                        <field name="mr_frame"/>
                    </setting>
                    <setting id="mr_show_line_numbers" string="Line numbers"
                             help="The # column in front of each item.">
                        <field name="mr_show_line_numbers"/>
                    </setting>
                    <setting id="mr_show_amount_words" string="Amount in words"
                             help="The total written out under the totals.">
                        <field name="mr_show_amount_words"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
