<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Lucide sun / moon, same strokes OmniRouters uses for light and dark. -->
    <t t-name="modern_theme.IconSun">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4"/>
            <path d="M12 2v2"/><path d="M12 20v2"/>
            <path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/>
            <path d="M2 12h2"/><path d="M20 12h2"/>
            <path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>
        </svg>
    </t>
    <t t-name="modern_theme.IconMoon">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
        </svg>
    </t>

    <t t-name="modern_theme.ThemeToggle">
        <div class="o_modern_theme_toggle d-flex align-items-center px-2">
            <Dropdown menuClass="'o_mt_theme_menu'" position="'bottom-end'">
                <button type="button"
                        class="btn btn-sm o_modern_theme_toggle_btn"
                        title="Theme"
                        aria-label="Theme: open to switch light, dark, and color.">
                    <t t-if="isDark" t-call="modern_theme.IconMoon"/>
                    <t t-else="" t-call="modern_theme.IconSun"/>
                </button>
                <t t-set-slot="content">
                    <div class="o_mt_theme_menu_label">Mode</div>
                    <DropdownItem class="'o_mt_theme_option' + (isDark ? '' : ' active')"
                                  onSelected="() => this.setDark(false)">
                        <span class="o_mt_theme_option_icon"><t t-call="modern_theme.IconSun"/></span>
                        <span>Light</span>
                    </DropdownItem>
                    <DropdownItem class="'o_mt_theme_option' + (isDark ? ' active' : '')"
                                  onSelected="() => this.setDark(true)">
                        <span class="o_mt_theme_option_icon"><t t-call="modern_theme.IconMoon"/></span>
                        <span>Dark</span>
                    </DropdownItem>
                    <div class="o_mt_theme_menu_label">Color</div>
                    <div class="o_modern_theme_preset_picker o_mt_theme_swatch_grid">
                        <t t-foreach="presets" t-as="option" t-key="option[0]">
                            <button type="button"
                                    class="o_modern_theme_swatch"
                                    t-att-class="{ selected: state.preset === option[0] }"
                                    t-att-style="'background-color:' + swatchColor(option[0])"
                                    t-att-title="option[1]"
                                    t-att-disabled="!canChangePreset"
                                    t-on-click.stop="() => this.setPreset(option[0])">
                                <i t-if="state.preset === option[0]" class="fa fa-check" aria-hidden="true"/>
                            </button>
                        </t>
                    </div>
                </t>
            </Dropdown>
        </div>
    </t>

</templates>
