<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Odoo's own layout, full width: control panel (+, title, search, pager, views) then the view. -->
    <t t-name="modern_theme.AppListPage">
        <t t-set="p" t-value="page.cssPrefix"/>
        <div t-attf-class="o_{{ p }} o_{{ p }}_page o_{{ p }}_page--native">
            <div t-attf-class="{{ p }}-container {{ p }}-container--native">
                <div t-if="!state.ready" t-attf-class="{{ p }}-card {{ p }}-native">
                    <div t-attf-class="{{ p }}-skeleton" style="height:3.5rem;margin:1rem 1.25rem"/>
                    <div t-attf-class="{{ p }}-skeleton" style="height:16rem;margin:0 1.25rem 1.25rem"/>
                </div>
                <AppNativeView t-else="" t-key="state.version" t-props="nativeProps"/>
            </div>
        </div>
    </t>
</templates>
