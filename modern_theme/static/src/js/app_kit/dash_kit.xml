<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="modern_theme.OdSparkline">
        <svg class="od-spark" t-attf-class="od-tone-{{ props.tone or 'blue' }}" viewBox="0 0 100 32" preserveAspectRatio="none" aria-hidden="true">
            <defs>
                <linearGradient t-att-id="gid" x1="0" x2="0" y1="0" y2="1">
                    <stop offset="0%" stop-color="currentColor" stop-opacity="0.22"/>
                    <stop offset="100%" stop-color="currentColor" stop-opacity="0"/>
                </linearGradient>
            </defs>
            <t t-if="!flat">
                <path t-att-d="area" t-att-fill="'url(#' + gid + ')'"/>
                <path t-att-d="line" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
            </t>
            <line t-else="" x1="0" x2="100" y1="28" y2="28" stroke="currentColor" stroke-opacity="0.25" stroke-dasharray="3 3" vector-effect="non-scaling-stroke"/>
        </svg>
    </t>

    <t t-name="modern_theme.OdKpi">
        <t t-set="tr" t-value="trend"/>
        <div t-attf-class="od-kpi od-tone-{{ props.tone or 'blue' }} {{ props.featured ? 'od-kpi--featured' : '' }} {{ props.onClick ? 'od-clickable' : '' }}"
             t-att-role="props.onClick ? 'button' : undefined" t-att-tabindex="props.onClick ? 0 : undefined"
             t-on-click="() => props.onClick and props.onClick()" t-on-keydown="(ev) => ev.key === 'Enter' and props.onClick and props.onClick()">
            <div class="od-kpi-top">
                <span class="od-kpi-icon" t-if="props.icon"><i t-attf-class="fa {{ props.icon }}" aria-hidden="true"/></span>
                <span class="od-kpi-label" t-esc="props.label"/>
                <i t-if="props.onClick" class="fa fa-arrow-right od-kpi-go" aria-hidden="true"/>
            </div>
            <div class="od-kpi-value od-num" t-esc="props.value"/>
            <div class="od-kpi-foot">
                <span t-if="tr" t-attf-class="od-delta od-delta--{{ tr.good === null ? 'flat' : (tr.good ? 'good' : 'bad') }}"
                      t-att-title="props.compareLabel">
                    <i t-attf-class="fa {{ tr.dir === 'up' ? 'fa-arrow-up' : (tr.dir === 'down' ? 'fa-arrow-down' : 'fa-minus') }}" aria-hidden="true"/>
                    <t t-esc="tr.text"/>
                </span>
                <span class="od-kpi-hint" t-esc="props.hint"/>
            </div>
            <OdSparkline t-if="props.spark" values="props.spark" tone="props.tone or 'blue'"/>
        </div>
    </t>

    <t t-name="modern_theme.OdComboChart">
        <t t-set="tot" t-value="totals"/>
        <div class="od-combo">
            <div class="od-combo-legend">
                <span class="od-legend-item"><i class="od-swatch od-swatch--bar"/> <t t-esc="props.currentLabel"/></span>
                <span t-if="hasPrevious" class="od-legend-item"><i class="od-swatch od-swatch--line"/> <t t-esc="props.previousLabel"/></span>
                <span t-if="tot.growth !== null" t-attf-class="od-delta ms-auto od-delta--{{ tot.growth >= 0 ? 'good' : 'bad' }}">
                    <i t-attf-class="fa {{ tot.growth >= 0 ? 'fa-arrow-up' : 'fa-arrow-down' }}" aria-hidden="true"/>
                    <t t-esc="(tot.growth >= 0 ? '+' : '') + tot.growth.toFixed(1) + '%'"/> year to date
                </span>
            </div>
            <figure class="od-chart" style="margin:0">
                <svg t-attf-viewBox="0 0 {{ W }} {{ H }}" role="img" t-att-aria-label="props.label"
                     t-on-pointermove="onMove" t-on-pointerleave="() => this.state.hover = null">
                    <t t-foreach="ticks" t-as="tick" t-key="tick_index">
                        <line t-att-x1="P.l" t-att-x2="W - P.r" t-att-y1="y(tick)" t-att-y2="y(tick)" class="od-grid-line" t-att-stroke-dasharray="tick ? '2 5' : undefined"/>
                        <text t-att-x="P.l - 10" t-att-y="y(tick)" dy="0.32em" text-anchor="end" class="od-axis" t-esc="props.formatAxis(tick)"/>
                    </t>
                    <t t-foreach="props.data" t-as="d" t-key="d_index">
                        <rect t-if="state.hover === d_index" t-att-x="cx(d_index) - band / 2 + 2" t-att-y="P.t" t-att-width="band - 4" t-att-height="H - P.t - P.b" rx="8" class="od-hover-band"/>
                        <rect t-att-x="cx(d_index) - barW / 2" t-att-y="y(d.value)" t-att-width="barW" t-att-height="barH(d.value)" rx="5"
                              t-attf-class="od-bar {{ d.future ? 'od-bar--future' : '' }} {{ state.hover === d_index ? 'od-bar--active' : '' }}"/>
                        <text t-att-x="cx(d_index)" t-att-y="H - 8" text-anchor="middle" t-attf-class="od-axis {{ d.future ? 'od-axis--future' : '' }}" t-esc="d.label"/>
                    </t>
                    <t t-if="hasPrevious">
                        <path t-att-d="prevLine" class="od-prev-line"/>
                        <t t-foreach="props.data" t-as="d" t-key="'p' + d_index">
                            <circle t-att-cx="cx(d_index)" t-att-cy="y(d.previous)" r="3" class="od-prev-dot"/>
                        </t>
                    </t>
                </svg>
                <div t-if="hovered" class="od-tooltip" t-attf-style="left: {{ cx(hovered.i) / W * 100 }}%">
                    <div class="od-tooltip-title" t-esc="hovered.label"/>
                    <div class="od-tooltip-row"><i class="od-swatch od-swatch--bar"/> <span t-esc="props.currentLabel"/> <strong class="od-num" t-esc="props.format(hovered.value)"/></div>
                    <div t-if="hasPrevious" class="od-tooltip-row"><i class="od-swatch od-swatch--line"/> <span t-esc="props.previousLabel"/> <strong class="od-num" t-esc="props.format(hovered.previous)"/></div>
                    <div t-if="hovered.growth !== null" t-attf-class="od-tooltip-growth {{ hovered.growth >= 0 ? 'is-good' : 'is-bad' }}">
                        <t t-esc="(hovered.growth >= 0 ? '+' : '') + hovered.growth.toFixed(1) + '%'"/>
                    </div>
                </div>
                <figcaption class="visually-hidden" t-esc="summary"/>
            </figure>
        </div>
    </t>

    <t t-name="modern_theme.OdDonut">
        <div class="od-donut">
            <svg viewBox="0 0 100 100" class="od-donut-svg" role="img" t-att-aria-label="props.centerLabel">
                <circle cx="50" cy="50" r="42" class="od-donut-track"/>
                <t t-foreach="arcs" t-as="a" t-key="a.i">
                    <circle cx="50" cy="50" r="42" t-attf-class="od-donut-arc od-tone-{{ a.tone }} od-chart-{{ a.i % 5 + 1 }} {{ state.hover !== null and state.hover !== a.i ? 'is-dim' : '' }}"
                            t-att-stroke-dasharray="a.dash" t-att-stroke-dashoffset="a.offset" transform="rotate(-90 50 50)"
                            t-on-pointerenter="() => this.state.hover = a.i" t-on-pointerleave="() => this.state.hover = null"/>
                </t>
                <text x="50" y="47" text-anchor="middle" class="od-donut-value" t-esc="center.value"/>
                <text x="50" y="60" text-anchor="middle" class="od-donut-label" t-esc="center.label.length > 18 ? center.label.slice(0, 17) + '…' : center.label"/>
            </svg>
            <ul class="od-legend">
                <t t-foreach="arcs" t-as="a" t-key="a.i">
                    <li t-attf-class="{{ state.hover === a.i ? 'is-active' : '' }} {{ props.onClick and a.id ? 'od-clickable' : '' }}"
                        t-on-pointerenter="() => this.state.hover = a.i" t-on-pointerleave="() => this.state.hover = null"
                        t-on-click="() => props.onClick and a.id and props.onClick(a)">
                        <i t-attf-class="od-dot od-tone-{{ a.tone }} od-chart-{{ a.i % 5 + 1 }}"/>
                        <span class="od-truncate od-legend-label" t-esc="a.label"/>
                        <span class="od-legend-share od-num" t-esc="Math.round(a.share * 100) + '%'"/>
                        <span class="od-legend-value od-num" t-esc="props.format(a.value)"/>
                    </li>
                </t>
            </ul>
        </div>
    </t>

    <t t-name="modern_theme.OdFunnel">
        <ol class="od-funnel">
            <t t-foreach="props.stages" t-as="s" t-key="s.id">
                <li t-attf-class="{{ s.won ? 'is-won' : '' }} {{ props.onClick ? 'od-clickable' : '' }}" t-on-click="() => props.onClick and props.onClick(s)">
                    <div class="od-funnel-meta">
                        <span class="od-funnel-name od-truncate">
                            <i t-if="s.won" class="fa fa-trophy" aria-hidden="true"/> <t t-esc="s.label"/>
                        </span>
                        <span class="od-funnel-count od-num"><t t-esc="s.count"/> <small>deals</small></span>
                        <span class="od-funnel-value od-num" t-esc="props.format(s.value)"/>
                    </div>
                    <div class="od-funnel-track"><span t-attf-style="width: {{ width(s) }}%"/></div>
                </li>
            </t>
        </ol>
    </t>

    <t t-name="modern_theme.OdRank">
        <ol t-attf-class="od-rank od-tone-{{ props.tone or 'blue' }}">
            <t t-foreach="props.items" t-as="item" t-key="item.id or item_index">
                <li t-att-class="{ 'od-clickable': props.onClick }" t-att-tabindex="props.onClick ? 0 : undefined"
                    t-on-click="() => props.onClick and props.onClick(item)" t-on-keydown="(ev) => ev.key === 'Enter' and props.onClick and props.onClick(item)">
                    <span t-if="props.numbered" t-attf-class="od-rank-no {{ item_index === 0 ? 'is-first' : '' }}" t-esc="item_index + 1"/>
                    <img t-if="avatar(item)" class="od-rank-avatar" t-att-src="avatar(item)" alt="" loading="lazy"/>
                    <span t-elif="item.partner" t-attf-class="od-rank-mono od-tone-{{ mono(item) }}" aria-hidden="true" t-esc="initials(item.label)"/>
                    <div class="od-rank-body">
                        <div class="od-rank-meta">
                            <span class="od-rank-label od-truncate" t-esc="item.label"/>
                            <span class="od-rank-value od-num" t-esc="props.format(item.value)"/>
                        </div>
                        <div class="od-rank-bar"><span t-attf-style="width: {{ width(item.value) }}%"/></div>
                        <div t-if="item.sub" class="od-rank-sub od-truncate" t-esc="item.sub"/>
                    </div>
                </li>
            </t>
        </ol>
    </t>

    <t t-name="modern_theme.OdAttention">
        <div t-if="clear" class="od-allclear">
            <span class="od-allclear-icon"><i class="fa fa-check" aria-hidden="true"/></span>
            <div><strong>All clear</strong><p>Nothing needs your attention right now.</p></div>
        </div>
        <ul t-else="" class="od-attention">
            <t t-foreach="props.items" t-as="item" t-key="item.key">
                <li t-attf-class="od-tone-{{ item.tone }} {{ item.count ? '' : 'is-zero' }} {{ props.onClick and item.count ? 'od-clickable' : '' }}"
                    t-att-tabindex="props.onClick and item.count ? 0 : undefined"
                    t-on-click="() => props.onClick and item.count and props.onClick(item)"
                    t-on-keydown="(ev) => ev.key === 'Enter' and props.onClick and item.count and props.onClick(item)">
                    <span class="od-att-icon"><i t-attf-class="fa {{ item.icon }}" aria-hidden="true"/></span>
                    <div class="od-att-body">
                        <span class="od-att-label" t-esc="item.label"/>
                        <span t-if="item.amount" class="od-att-sub od-num" t-esc="props.format(item.amount)"/>
                        <span t-elif="item.late" class="od-att-sub"><t t-esc="item.late"/> past the promised date</span>
                    </div>
                    <span class="od-att-count od-num" t-esc="item.count"/>
                    <i t-if="props.onClick and item.count" class="fa fa-angle-right od-att-go" aria-hidden="true"/>
                </li>
            </t>
        </ul>
    </t>

    <t t-name="modern_theme.OdStack">
        <div class="od-stack">
            <div class="od-stack-bar" role="img" t-att-aria-label="props.items.map((i) => i.label + ' ' + props.format(i.value)).join(', ')">
                <t t-foreach="props.items" t-as="item" t-key="item_index">
                    <span t-if="item.value > 0" t-attf-class="od-tone-{{ tone(item_index) }}" t-attf-style="width: {{ share(item.value) }}%" t-att-title="item.label + ': ' + props.format(item.value)"/>
                </t>
                <span t-if="!total" class="od-stack-empty"/>
            </div>
            <ul class="od-stack-legend">
                <t t-foreach="props.items" t-as="item" t-key="item_index">
                    <li>
                        <i t-attf-class="od-dot od-tone-{{ tone(item_index) }}"/>
                        <span class="od-stack-label" t-esc="item.label"/>
                        <strong class="od-num" t-esc="props.format(item.value)"/>
                    </li>
                </t>
            </ul>
        </div>
    </t>

    <t t-name="modern_theme.OdFilters">
        <div class="od-filters">
            <div class="od-seg" role="tablist" aria-label="Period">
                <t t-foreach="periods" t-as="p" t-key="p.key">
                    <button type="button" role="tab" t-att-aria-selected="props.period === p.key ? 'true' : 'false'"
                            t-attf-class="{{ props.period === p.key ? 'is-active' : '' }}" t-att-disabled="props.busy"
                            t-on-click="() => props.onChange({ period: p.key })" t-esc="p.label"/>
                </t>
            </div>
            <label t-if="props.teams.length > 1" class="od-select">
                <i t-attf-class="fa {{ props.icon or 'fa-users' }} od-select-icon" aria-hidden="true"/>
                <select t-on-change="onTeam" t-att-aria-label="props.label or 'Sales team'" t-att-disabled="props.busy">
                    <option value="" t-att-selected="!props.teamId" t-esc="props.allLabel or 'All teams'"/>
                    <t t-foreach="props.teams" t-as="t" t-key="t.id">
                        <option t-att-value="t.id" t-att-selected="props.teamId === t.id" t-esc="t.name"/>
                    </t>
                </select>
                <i class="fa fa-angle-down od-select-caret" aria-hidden="true"/>
            </label>
        </div>
    </t>


    <t t-name="modern_theme.OdGoal">
        <div class="od-goal" role="status">
            <span class="od-goal-icon"><i t-attf-class="fa {{ props.icon or 'fa-bullseye' }}" aria-hidden="true"/></span>
            <div class="od-goal-body">
                <strong t-esc="props.title"/>
                <p t-if="props.text" t-esc="props.text"/>
                <div class="od-goal-track" role="progressbar" t-att-aria-valuenow="width" aria-valuemin="0" aria-valuemax="100">
                    <span t-attf-style="width: {{ width }}%"/>
                </div>
            </div>
            <span class="od-goal-pct od-num"><t t-esc="rounded"/>%</span>
            <button t-if="props.actionLabel and props.onAction" type="button" class="od-btn" t-on-click="() => props.onAction()">
                <t t-esc="props.actionLabel"/> <i class="fa fa-angle-right" aria-hidden="true"/>
            </button>
        </div>
    </t>

    <t t-name="modern_theme.OdProgressList">
        <ul t-attf-class="od-plist od-tone-{{ props.tone or 'blue' }}">
            <t t-foreach="props.items" t-as="item" t-key="item.id or item_index">
                <li t-att-class="{ 'od-clickable': props.onClick }" t-att-tabindex="props.onClick ? 0 : undefined"
                    t-on-click="() => props.onClick and props.onClick(item)"
                    t-on-keydown="(ev) => ev.key === 'Enter' and props.onClick and props.onClick(item)">
                    <div class="od-plist-meta">
                        <span class="od-plist-label od-truncate" t-esc="item.label"/>
                        <span t-if="item.delta !== undefined and item.delta !== null"
                              t-attf-class="od-plist-delta od-num {{ item.delta >= 0 ? 'is-good' : 'is-bad' }}"
                              t-esc="(item.delta >= 0 ? '+' : '') + item.delta + '%'"/>
                        <span class="od-plist-value od-num" t-esc="item.value"/>
                    </div>
                    <div class="od-plist-track"><span t-attf-class="{{ item.tone ? 'od-tone-' + item.tone : '' }}" t-attf-style="width: {{ barWidth(item) }}%"/></div>
                    <div t-if="item.sub" class="od-plist-sub od-truncate" t-esc="item.sub"/>
                </li>
            </t>
        </ul>
    </t>

    <t t-name="modern_theme.OdTasks">
        <div t-if="!props.items.length" class="od-empty"><i class="fa fa-check-circle-o" aria-hidden="true"/><strong t-esc="props.emptyText or 'Nothing to do'"/></div>
        <ul t-else="" class="od-tasks">
            <t t-foreach="props.items" t-as="item" t-key="item.id">
                <li t-att-class="{ 'is-done': state.done[item.id], 'od-clickable': props.onClick }"
                    t-on-click="() => props.onClick and props.onClick(item)">
                    <button t-if="props.onToggle" type="button" class="od-task-check" t-att-aria-pressed="state.done[item.id] ? 'true' : 'false'"
                            title="Mark as done" aria-label="Mark as done" t-on-click="(ev) => this.toggle(item, ev)">
                        <i t-if="state.done[item.id]" class="fa fa-check" aria-hidden="true"/>
                    </button>
                    <div class="od-task-body">
                        <span class="od-task-title" t-esc="item.title"/>
                        <span t-if="item.sub" class="od-task-sub od-truncate" t-esc="item.sub"/>
                        <div class="od-task-tags">
                            <span t-if="item.priority" t-attf-class="od-badge od-badge--{{ item.priority }}" t-esc="priorityLabel(item.priority)"/>
                            <span t-if="item.due" t-attf-class="od-badge od-badge--outline {{ item.dueTone ? 'od-tone-' + item.dueTone : '' }}">
                                <i class="fa fa-clock-o" aria-hidden="true"/> <t t-esc="item.due"/>
                            </span>
                        </div>
                    </div>
                </li>
            </t>
        </ul>
    </t>

    <t t-name="modern_theme.OdTable">
        <div class="od-dtable">
            <div class="od-table-wrap">
                <table class="od-table">
                    <thead>
                        <tr>
                            <t t-foreach="props.columns" t-as="c" t-key="c.key">
                                <th t-att-class="{ 'od-r': c.align === 'end' }" t-esc="c.label"/>
                            </t>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-if="!props.rows.length"><td t-att-colspan="props.columns.length" class="od-dtable-empty" t-esc="props.emptyText or 'No records yet'"/></tr>
                        <t t-foreach="visible" t-as="row" t-key="row.id or row_index">
                            <tr t-att-class="{ 'od-clickable': props.onRowClick }" t-on-click="() => props.onRowClick and props.onRowClick(row)">
                                <t t-foreach="props.columns" t-as="c" t-key="c.key">
                                    <td t-att-class="{ 'od-r': c.align === 'end', 'od-num': c.type === 'num', 'text-muted': c.type === 'muted' }">
                                        <t t-if="c.type === 'person'">
                                            <div class="od-person">
                                                <img t-if="row[c.key + '_avatar']" class="od-person-avatar" t-att-src="row[c.key + '_avatar']" alt="" loading="lazy"/>
                                                <span t-else="" t-attf-class="od-person-avatar od-tone-{{ toneOf(row[c.key]) }}" aria-hidden="true" t-esc="initials(row[c.key])"/>
                                                <div class="od-person-text">
                                                    <span class="od-person-name od-truncate" t-esc="row[c.key] or '—'"/>
                                                    <span t-if="row[c.key + '_sub']" class="od-person-sub od-truncate" t-esc="row[c.key + '_sub']"/>
                                                </div>
                                            </div>
                                        </t>
                                        <t t-elif="c.type === 'badge'"><span t-if="row[c.key]" t-attf-class="od-badge od-badge--soft od-tone-{{ row[c.key + '_tone'] or 'slate' }}" t-esc="row[c.key]"/></t>
                                        <t t-else="" t-esc="row[c.key] === false or row[c.key] === undefined or row[c.key] === '' ? '—' : row[c.key]"/>
                                    </td>
                                </t>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
            <div t-if="props.rows.length > size" class="od-dtable-foot">
                <span class="od-dtable-range"><t t-esc="range"/> <t t-esc="props.unit or ''"/></span>
                <div class="od-dtable-pager">
                    <button type="button" class="od-btn od-btn--sm" t-att-disabled="page === 0" t-on-click="() => this.go(-1)" aria-label="Previous page">
                        <i class="fa fa-angle-left" aria-hidden="true"/> Previous
                    </button>
                    <button type="button" class="od-btn od-btn--sm" t-att-disabled="page >= pages - 1" t-on-click="() => this.go(1)" aria-label="Next page">
                        Next <i class="fa fa-angle-right" aria-hidden="true"/>
                    </button>
                </div>
            </div>
        </div>
    </t>

    <t t-name="modern_theme.OdFeed">
        <ul class="od-feed">
            <t t-foreach="props.items" t-as="item" t-key="item.id or item_index">
                <li t-att-class="{ 'od-clickable': props.onClick }" t-on-click="() => props.onClick and props.onClick(item)">
                    <img t-if="item.avatar" class="od-person-avatar" t-att-src="item.avatar" alt="" loading="lazy"/>
                    <span t-else="" t-attf-class="od-person-avatar od-tone-{{ toneOf(item.name) }}" aria-hidden="true" t-esc="initials(item.name)"/>
                    <div class="od-feed-body">
                        <span class="od-feed-name od-truncate" t-esc="item.name"/>
                        <span class="od-feed-text od-truncate" t-esc="item.text"/>
                    </div>
                    <span class="od-feed-time" t-esc="item.time"/>
                </li>
            </t>
        </ul>
    </t>

    <t t-name="modern_theme.OdStatusTiles">
        <div class="od-tiles">
            <t t-foreach="props.items" t-as="item" t-key="item.key">
                <div t-attf-class="od-tile od-tone-{{ item.tone or 'slate' }} {{ props.onClick ? 'od-clickable' : '' }}"
                     t-att-tabindex="props.onClick ? 0 : undefined"
                     t-on-click="() => props.onClick and props.onClick(item)"
                     t-on-keydown="(ev) => ev.key === 'Enter' and props.onClick and props.onClick(item)">
                    <div class="od-tile-top">
                        <span class="od-tile-label" t-esc="item.label"/>
                        <i t-if="item.icon" t-attf-class="fa {{ item.icon }}" aria-hidden="true"/>
                    </div>
                    <strong class="od-tile-count od-num" t-esc="item.count"/>
                    <span t-if="item.sub" class="od-tile-sub" t-esc="item.sub"/>
                </div>
            </t>
        </div>
    </t>

    <t t-name="modern_theme.OdError">
        <div class="od-card od-error" role="alert">
            <span class="od-card-icon od-tone-rose"><i class="fa fa-exclamation-triangle" aria-hidden="true"/></span>
            <div class="od-error-text">
                <h3>This dashboard could not be loaded</h3>
                <p t-if="props.message" t-esc="props.message"/>
            </div>
            <button type="button" class="od-btn od-btn--primary" t-on-click="() => props.onRetry()">
                <i class="fa fa-refresh" aria-hidden="true"/> Try again
            </button>
        </div>
    </t>
</templates>
