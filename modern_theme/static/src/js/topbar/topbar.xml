<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- Odoo's navbar keeps its systray, user menu, company switcher and badges:
         we only add a start area after the apps menu. -->
    <t t-inherit="web.NavBar" t-inherit-mode="extension">
        <xpath expr="//nav[hasclass('o_main_navbar')]/t[@t-call='web.NavBar.AppsMenu']" position="after">
            <MtTopbarStart/>
        </xpath>
    </t>

    <t t-name="modern_theme.TopbarStart">
        <div class="mt-topbar-start">
            <button type="button" class="mt-topbar-burger" t-on-click="toggleSidebar" aria-label="Open menu" title="Menu">
                <i class="fa fa-bars" aria-hidden="true"/>
            </button>
            <button t-if="showCollapse" type="button" class="mt-topbar-iconbtn mt-topbar-collapse" t-on-click="toggleCollapse"
                    aria-label="Toggle sidebar" title="Toggle sidebar">
                <t t-call="modern_theme.Lucide"><t t-set="name" t-value="'panel-left'"/></t>
            </button>
            <!-- Apps menu: always in the top bar, opens any app -->
            <Dropdown position="'bottom-start'" menuClass="'mt-topbar-apps-menu'">
                <button type="button" class="mt-topbar-iconbtn mt-topbar-apps" aria-label="Apps" title="Apps">
                    <t t-call="modern_theme.Lucide"><t t-set="name" t-value="'layout-grid'"/></t>
                </button>
                <t t-set-slot="content">
                    <div class="mt-apps-head">Apps</div>
                    <div class="mt-apps-grid">
                        <t t-foreach="apps" t-as="item" t-key="item.id">
                            <DropdownItem class="'mt-apps-item' + (isCurrentApp(item) ? ' is-active' : '')"
                                          onSelected="() => this.openApp(item)"
                                          attrs="{ href: appHref(item), title: item.name, 'data-menu-xmlid': item.xmlid }">
                                <t t-set="ic" t-value="appIcon(item)"/>
                                <span class="mt-app-icon"
                                      t-att-class="{ 'is-generated': ic.generated, 'is-font': ic.iconClass }"
                                      t-att-style="ic.generated ? '--mt-app-hue:' + ic.generated.hue : (ic.iconClass ? 'background:' + ic.backgroundColor + ';color:' + ic.color : '')"
                                      aria-hidden="true">
                                    <img t-if="ic.src" t-att-src="ic.src" alt="" loading="lazy"/>
                                    <i t-elif="ic.iconClass" t-att-class="ic.iconClass"/>
                                    <t t-else="" t-esc="ic.generated.initials"/>
                                </span>
                                <span class="mt-apps-name" t-esc="item.name"/>
                            </DropdownItem>
                        </t>
                    </div>
                </t>
            </Dropdown>
            <div t-if="app" class="mt-topbar-app">
                <t t-call="modern_theme.AppIcon"/>
                <span class="mt-topbar-app-name" t-esc="app.name"/>
            </div>
            <nav t-if="topMenus.length" class="mt-topbar-menus" aria-label="More menus of this app">
                <t t-foreach="topMenus" t-as="node" t-key="node.id">
                    <a t-if="!node.children.length" class="mt-topbar-menu" t-att-title="node.name" t-att-class="{ 'is-active': isActive(node) }"
                       t-att-href="node.href" t-att-data-menu-xmlid="node.xmlid" t-on-click="(ev) => this.openNode(node, ev)">
                        <i t-attf-class="fa {{ topIcon(node) }}" aria-hidden="true"/><span t-esc="node.name"/>
                    </a>
                    <Dropdown t-else="" position="'bottom-start'" menuClass="'mt-topbar-dropdown'">
                        <button type="button" class="mt-topbar-menu" t-att-title="node.name" t-att-class="{ 'is-active': isActive(node) }"
                                t-att-data-menu-xmlid="node.xmlid">
                            <i t-attf-class="fa {{ topIcon(node) }}" aria-hidden="true"/><span t-esc="node.name"/>
                            <i class="fa fa-angle-down mt-topbar-caret" aria-hidden="true"/>
                        </button>
                        <t t-set-slot="content">
                            <t t-foreach="entries(node)" t-as="entry" t-key="entry.id">
                                <div t-if="entry.heading" class="mt-topbar-dd-heading" t-esc="entry.name"/>
                                <DropdownItem t-else="" class="'mt-topbar-dd-item' + (isActive(entry) ? ' is-active' : '')"
                                              onSelected="() => this.openNode(entry)"
                                              attrs="{ href: entry.href, 'data-menu-xmlid': entry.xmlid }">
                                    <i t-if="entry.icon" t-attf-class="fa fa-fw {{ entry.icon }}" aria-hidden="true"/>
                                    <span t-esc="entry.name"/>
                                </DropdownItem>
                            </t>
                        </t>
                    </Dropdown>
                </t>
            </nav>
            <button type="button" class="mt-topbar-search" t-on-click="openSearch"
                    title="Search (Ctrl+K)" aria-label="Search apps, menus and records">
                <i class="fa fa-search" aria-hidden="true"/>
                <span class="mt-topbar-search-text">Search apps, menus, records…</span>
                <kbd>Ctrl K</kbd>
            </button>
        </div>
    </t>

    <t t-name="modern_theme.ThemeSwitcher">
        <div class="o_mt_theme_switcher d-flex align-items-center">
            <button type="button" class="mt-sys-btn" t-on-click="toggleDark"
                    t-att-title="isDark ? 'Switch to light mode' : 'Switch to dark mode'"
                    t-att-aria-label="isDark ? 'Switch to light mode' : 'Switch to dark mode'">
                <i t-attf-class="fa {{ isDark ? 'fa-sun-o' : 'fa-moon-o' }}" aria-hidden="true"/>
            </button>
            <Dropdown position="'bottom-end'" menuClass="'mt-switcher-menu'">
                <button type="button" class="mt-sys-btn" title="Appearance" aria-label="Appearance">
                    <i class="fa fa-paint-brush" aria-hidden="true"/>
                </button>
                <t t-set-slot="content">
                    <div class="mt-switcher">
                        <div class="mt-switcher-label">Mode</div>
                        <div class="mt-segmented" role="radiogroup" aria-label="Color mode">
                            <button type="button" role="radio" t-att-aria-checked="state.values.color_mode === 'light' ? 'true' : 'false'" t-on-click="() => this.set('color_mode', 'light')"><i class="fa fa-sun-o" aria-hidden="true"/> Light</button>
                            <button type="button" role="radio" t-att-aria-checked="state.values.color_mode === 'dark' ? 'true' : 'false'" t-on-click="() => this.set('color_mode', 'dark')"><i class="fa fa-moon-o" aria-hidden="true"/> Dark</button>
                            <button type="button" role="radio" t-att-aria-checked="state.values.color_mode === 'auto' ? 'true' : 'false'" t-on-click="() => this.set('color_mode', 'auto')"><i class="fa fa-desktop" aria-hidden="true"/> Auto</button>
                        </div>
                        <div class="mt-switcher-label">Brand color</div>
                        <div class="mt-swatches mt-swatches-sm" role="radiogroup" aria-label="Brand color">
                            <t t-foreach="presets" t-as="preset" t-key="preset[0]">
                                <button type="button" class="mt-swatch" role="radio"
                                        t-att-aria-checked="state.values.preset === preset[0] ? 'true' : 'false'"
                                        t-att-style="'--mt-swatch:' + swatches[preset[0]]"
                                        t-att-title="preset[1]" t-att-aria-label="preset[1]"
                                        t-on-click="() => this.set('preset', preset[0])">
                                    <i class="fa fa-check" aria-hidden="true"/>
                                </button>
                            </t>
                        </div>
                        <div class="mt-switcher-label">Sidebar</div>
                        <div class="mt-cards mt-cards-sm" role="radiogroup" aria-label="Sidebar style">
                            <t t-foreach="styles" t-as="style" t-key="style[0]">
                                <button type="button" class="mt-card-choice" role="radio"
                                        t-att-aria-checked="state.values.sidebar_style === style[0] ? 'true' : 'false'"
                                        t-on-click="() => this.set('sidebar_style', style[0])">
                                    <t t-call="modern_theme.SidebarStylePreview"><t t-set="variant" t-value="style[0]"/></t>
                                    <span t-esc="style[1]"/>
                                </button>
                            </t>
                        </div>
                        <button type="button" class="btn btn-secondary btn-sm w-100 mt-2" t-on-click="openMore">
                            <i class="fa fa-sliders me-1" aria-hidden="true"/> All appearance options…
                        </button>
                    </div>
                </t>
            </Dropdown>
        </div>
    </t>

</templates>
