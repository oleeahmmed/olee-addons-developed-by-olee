<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="modern_theme.SegmentedField">
        <div class="mt-segmented" role="radiogroup">
            <t t-foreach="options" t-as="option" t-key="option[0]">
                <button type="button" role="radio" t-att-disabled="props.readonly"
                        t-att-aria-checked="value === option[0] ? 'true' : 'false'"
                        t-on-click="() => this.select(option[0])" t-esc="option[1]"/>
            </t>
        </div>
    </t>

    <t t-name="modern_theme.SidebarCardsField">
        <div class="mt-cards" role="radiogroup">
            <t t-foreach="options" t-as="option" t-key="option[0]">
                <button type="button" class="mt-card-choice" role="radio" t-att-disabled="props.readonly"
                        t-att-aria-checked="value === option[0] ? 'true' : 'false'"
                        t-on-click="() => this.select(option[0])">
                    <t t-call="modern_theme.SidebarStylePreview"><t t-set="variant" t-value="option[0]"/></t>
                    <span t-esc="option[1]"/>
                </button>
            </t>
        </div>
    </t>

    <t t-name="modern_theme.SwatchField">
        <div class="mt-swatches" role="radiogroup" aria-label="Brand color">
            <t t-foreach="presets" t-as="preset" t-key="preset[0]">
                <button type="button" class="mt-swatch" role="radio"
                        t-att-aria-checked="value === preset[0] ? 'true' : 'false'"
                        t-att-style="'--mt-swatch:' + swatches[preset[0]]"
                        t-att-title="preset[1]" t-att-aria-label="preset[1]"
                        t-on-click="() => this.select(preset[0])">
                    <i class="fa fa-check" aria-hidden="true"/>
                </button>
            </t>
            <label class="mt-swatch mt-swatch-custom" title="Custom color"
                   t-att-aria-checked="value === 'custom' ? 'true' : 'false'"
                   t-att-style="'--mt-swatch:' + customColor">
                <input type="color" t-att-value="customColor" aria-label="Custom color" t-on-change="onCustom"/>
                <i class="fa fa-eyedropper" aria-hidden="true"/>
            </label>
        </div>
    </t>

    <t t-name="modern_theme.ThemePreview">
        <div class="mt-preview-wrap">
            <div class="mt-preview-toolbar">
                <div>
                    <strong>Live preview</strong>
                    <small>The whole interface shows these settings now. Save to apply them for everyone; your personal choices (Appearance menu) still win for you.</small>
                </div>
                <div class="mt-preview-actions">
                    <button type="button" class="btn btn-secondary btn-sm" t-on-click="importJson"><i class="fa fa-upload me-1" aria-hidden="true"/>Import</button>
                    <button type="button" class="btn btn-secondary btn-sm" t-on-click="exportJson"><i class="fa fa-download me-1" aria-hidden="true"/>Export</button>
                    <button type="button" class="btn btn-outline-danger btn-sm" t-on-click="resetDefaults"><i class="fa fa-undo me-1" aria-hidden="true"/>Reset to default</button>
                    <input type="file" accept="application/json,.json" class="d-none" t-ref="file" t-on-change="onFile"/>
                </div>
            </div>
            <!-- A miniature app drawn with the same tokens as the real interface. -->
            <div class="mt-preview" aria-hidden="true">
                <div class="mt-pv-side" t-att-data-style="values.sidebar_style">
                    <div class="mt-pv-brand"><span class="mt-pv-logo"/><b/></div>
                    <div class="mt-pv-search"/>
                    <div class="mt-pv-item is-active"><i/><b/></div>
                    <div class="mt-pv-item"><i/><b/></div>
                    <div class="mt-pv-item"><i/><b/></div>
                    <div class="mt-pv-group">Reports</div>
                    <div class="mt-pv-item"><i/><b/></div>
                    <div class="mt-pv-item"><i/><b/></div>
                </div>
                <div class="mt-pv-main">
                    <div class="mt-pv-top"><span class="mt-pv-crumb">Pipeline</span><span class="mt-pv-pill"/><span class="mt-pv-avatar"/></div>
                    <div class="mt-pv-content">
                        <div class="mt-pv-kpis">
                            <div class="mt-pv-card"><small>Pipeline</small><strong>৳ 12.4L</strong><span class="mt-pv-delta is-up">+8.2%</span></div>
                            <div class="mt-pv-card"><small>Won</small><strong>৳ 4.1L</strong><span class="mt-pv-delta is-up">+3.1%</span></div>
                            <div class="mt-pv-card"><small>Win rate</small><strong>38%</strong><span class="mt-pv-delta is-down">−1.4</span></div>
                        </div>
                        <div class="mt-pv-card mt-pv-table">
                            <div class="mt-pv-row is-head"><span>Opportunity</span><span>Stage</span><span>Revenue</span></div>
                            <div class="mt-pv-row"><span>Mostafa Group ERP</span><span class="mt-pv-badge">Proposal</span><span>৳ 2,50,000</span></div>
                            <div class="mt-pv-row"><span>নতুন গ্রাহক — Dhaka</span><span class="mt-pv-badge is-success">Won</span><span>৳ 85,000</span></div>
                            <div class="mt-pv-row"><span>Chattogram Port Ltd</span><span class="mt-pv-badge is-warning">Qualified</span><span>৳ 1,20,000</span></div>
                        </div>
                        <div class="mt-pv-buttons">
                            <span class="mt-pv-btn is-primary">New</span>
                            <span class="mt-pv-btn">Import</span>
                            <span class="mt-pv-input">Search…</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
