<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Backend: every design option is written on <html> by the server
        (data-mt-* + custom colors), so the very first paint is already right.
    -->
    <template id="webclient_bootstrap_theme" inherit_id="web.webclient_bootstrap">
        <xpath expr="//t[@t-set='body_classname']" position="after">
            <t t-set="html_data" t-value="mt_html_attrs or {'data-mt-theme': modern_theme_preset or 'indigo'}"/>
        </xpath>
        <xpath expr="//t[@t-set='head_web']/meta[@name='theme-color']" position="replace">
            <meta name="theme-color" t-att-content="(mt_values or {}).get('scheme_color') or '#4f46e5'"/>
            <!--
                "Auto" mode on the very first visit: the server could not know the
                OS preference yet. Store it in the cookie it reads next time and,
                if needed, switch the stylesheet before the page is shown.
            -->
            <script t-if="(mt_values or {}).get('color_mode') == 'auto'">
                (function () {
                    var dark = window.matchMedia &amp;&amp; window.matchMedia("(prefers-color-scheme: dark)").matches;
                    document.cookie = "color_scheme=" + (dark ? "dark" : "light") + "; path=/; max-age=31536000";
                })();
            </script>
        </xpath>
    </template>

    <!--
        Login page: three styles (split / centered / minimal). Odoo's form, fields,
        CSRF token and OAuth / signup links are kept untouched.
    -->
    <template id="login_layout_modern" inherit_id="web.login_layout">
        <xpath expr="//t[@t-set='html_data']" position="replace">
            <t t-set="mt_login" t-value="request.env['ir.http']._mt_login_context()"/>
            <t t-set="html_data" t-value="mt_login['attrs']"/>
        </xpath>
        <xpath expr="//t[@t-set='body_classname']" position="replace">
            <t t-set="body_classname" t-value="'o_mt_login o_mt_login--%s' % mt_login['style']"/>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="class" add="o_mt_login_wrap" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="before">
            <aside t-if="mt_login['style'] == 'split'" class="o_mt_login_hero"
                   t-att-style="mt_login['background'] and ('--mt-login-bg: url(%s)' % mt_login['background']) or None">
                <div class="o_mt_login_hero_inner">
                    <img class="o_mt_login_hero_logo" t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}" alt=""/>
                    <h1 t-esc="mt_login['company_name']"/>
                    <p t-if="mt_login['tagline']" t-esc="mt_login['tagline']"/>
                </div>
            </aside>
            <div t-if="mt_login['style'] == 'centered' and mt_login['background']" class="o_mt_login_bg"
                 t-att-style="'--mt-login-bg: url(%s)' % mt_login['background']"/>
        </xpath>
        <xpath expr="//a[contains(@href, 'utm_medium=auth')]" position="replace"/>
    </template>

</odoo>
