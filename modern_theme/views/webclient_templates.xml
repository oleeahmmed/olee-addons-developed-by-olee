<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="webclient_bootstrap_theme" inherit_id="web.webclient_bootstrap">
        <xpath expr="//t[@t-set='body_classname']" position="after">
            <t t-set="html_data" t-value="{'data-mt-theme': modern_theme_preset}"/>
        </xpath>
    </template>

    <!--
        Login restyle: inherit Odoo's layout, keep the form/fields/CSRF.
        If a future Odoo build drops these t-set / class hooks the inherit
        fails loudly on upgrade instead of silently breaking login.
    -->
    <template id="login_layout_modern" inherit_id="web.login_layout">
        <xpath expr="//t[@t-set='html_data']" position="replace">
            <t t-set="html_data" t-value="{'style': 'height: 100%;', 'data-mt-theme': request.env['ir.http']._modern_theme_preset()}"/>
        </xpath>
        <xpath expr="//t[@t-set='body_classname']" position="replace">
            <t t-set="body_classname" t-value="'bg-100 o_mt_login'"/>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="class" add="o_mt_login_wrap" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="before">
            <aside class="o_mt_login_aside" aria-hidden="true">
                <p class="o_mt_login_kicker">Welcome</p>
                <h1 t-esc="request.env.company.name"/>
                <p>Sign in to continue to your workspace.</p>
            </aside>
        </xpath>
    </template>

</odoo>
