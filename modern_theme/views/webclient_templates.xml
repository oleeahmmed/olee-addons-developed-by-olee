<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Backend: the fixed shadcn look is written on <html> by the server
        (data-mt-* attributes), so the very first paint is already right.
    -->
    <template id="webclient_bootstrap_theme" inherit_id="web.webclient_bootstrap">
        <xpath expr="//t[@t-set='body_classname']" position="after">
            <t t-set="html_data" t-value="mt_html_attrs or {}"/>
        </xpath>
        <xpath expr="//t[@t-set='head_web']/meta[@name='theme-color']" position="replace">
            <meta name="theme-color" content="#ffffff"/>
        </xpath>
    </template>

    <!--
        Login page: one shadcn/ui card on a soft grey page. Odoo's form, fields,
        CSRF token, database selector and OAuth / signup links are kept untouched.
    -->
    <template id="login_layout_modern" inherit_id="web.login_layout">
        <xpath expr="//t[@t-set='html_data']" position="replace">
            <t t-set="mt_login" t-value="request.env['ir.http']._mt_login_context()"/>
            <t t-set="html_data" t-value="mt_login['attrs']"/>
        </xpath>
        <xpath expr="//t[@t-set='body_classname']" position="replace">
            <t t-set="body_classname" t-value="'o_mt_login'"/>
        </xpath>
        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="class" add="o_mt_login_wrap" separator=" "/>
        </xpath>
        <xpath expr="//a[contains(@href, 'utm_medium=auth')]" position="replace"/>
    </template>

    <!--
        Login form: shadcn-style card header. Only a header block is inserted
        next to Odoo's own form, so the CSRF token, database selector, fields,
        alerts, buttons, OAuth call, account switcher and hidden inputs are
        never touched and keep working after an Odoo upgrade.
    -->
    <template id="login_form_modern" inherit_id="web.login" priority="20">
        <xpath expr="//div[@id='oe_structure_login_top']" position="after">
            <div class="o_mt_login_header">
                <h1 class="o_mt_login_title">Login to your account</h1>
                <p class="o_mt_login_desc">Enter your email below to login to your account.</p>
            </div>
        </xpath>
    </template>

    <!-- Replace the "- or -" separator with text / hairline dividers (CSS in login.scss). -->
    <template id="login_oauth_modern" inherit_id="web.login_oauth" priority="20">
        <xpath expr="//em" position="replace">
            <div class="o_mt_login_divider"><span>Or continue with</span></div>
        </xpath>
    </template>

</odoo>
