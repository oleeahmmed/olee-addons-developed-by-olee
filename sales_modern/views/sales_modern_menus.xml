<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        No app of its own: everything lives inside Odoo's Sales app (sale.sale_menu_root).
        The Dashboard comes first, so opening Sales from the home screen opens Sales Modern.
        Odoo's own Sales menus are left untouched and all shown in the sidebar (Reporting,
        Configuration, menus of other apps...). Visibility comes from Odoo's groups.
    -->
    <menuitem id="menu_dashboard" name="Dashboard" parent="sale.sale_menu_root" action="action_dashboard"
              sequence="-110" groups="sales_team.group_sale_salesman"/>

    <menuitem id="menu_sell" name="Sell" parent="sale.sale_menu_root" sequence="-90" groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_quotations" name="Quotations" parent="menu_sell" action="action_quotations" sequence="1"/>
    <menuitem id="menu_orders" name="Sales Orders" parent="menu_sell" action="action_orders" sequence="2"/>
    <menuitem id="menu_to_invoice" name="To Invoice" parent="menu_sell" action="action_to_invoice" sequence="3"/>
    <menuitem id="menu_customers" name="Customers" parent="menu_sell" action="action_customers" sequence="4"/>

    <menuitem id="menu_catalog" name="Catalog" parent="sale.sale_menu_root" sequence="-80" groups="sales_team.group_sale_salesman"/>
    <menuitem id="menu_products" name="Products" parent="menu_catalog" action="action_products" sequence="1"/>
    <!-- Odoo's own pricelists, shown only when Settings ▸ Pricelists is on (same group as Odoo) -->
    <menuitem id="menu_pricelists" name="Pricelists" parent="menu_catalog" action="product.product_pricelist_action2"
              sequence="2" groups="product.group_product_pricelist"/>

    <!-- Teams are managed by sales managers, as in Odoo (Configuration ▸ Sales Teams) -->
    <menuitem id="menu_team" name="Team" parent="sale.sale_menu_root" sequence="-70" groups="-sales_team.group_sale_salesman,sales_team.group_sale_manager"/>
    <menuitem id="menu_teams" name="Sales Teams" parent="menu_team" action="action_teams" sequence="1"/>
    <menuitem id="menu_salespeople" name="Salespeople" parent="menu_team" action="action_salespeople" sequence="2"/>

    <!-- No own "Setup" group: Odoo's full Configuration menu is shown in the sidebar. -->
</odoo>
