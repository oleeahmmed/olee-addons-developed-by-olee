<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sales_modern.PageBar">
        <header class="ss-pagebar">
            <div class="ss-pagebar-title">
                <span t-if="props.icon" class="ss-pagebar-icon" aria-hidden="true"><i t-attf-class="fa {{ props.icon }}"/></span>
                <div class="min-w-0">
                    <h1 t-esc="props.title"/>
                    <p t-if="props.subtitle" t-esc="props.subtitle"/>
                </div>
            </div>
            <div class="ss-pagebar-actions">
                <t t-slot="default"/>
                <button t-if="props.onCreate" type="button" class="ss-btn ss-btn-primary ss-btn-new" data-hotkey="c"
                        t-att-title="(props.newLabel or 'New') + ' (Alt+C)'" t-on-click="() => props.onCreate()">
                    <i class="fa fa-plus" aria-hidden="true"/><span t-esc="props.newLabel or 'New'"/>
                </button>
            </div>
        </header>
    </t>

    <!-- Odoo's own layout, full width: control panel (New, title, search, pager, views) then the view. -->
    <t t-name="sales_modern.ListPage">
        <div class="o_ss o_ss_page o_ss_page--native">
            <div class="ss-container ss-container--native">
                <div t-if="!state.ready" class="ss-card ss-native">
                    <div class="ss-skeleton" style="height:3.5rem;margin:1rem 1.25rem"/>
                    <div class="ss-skeleton" style="height:16rem;margin:0 1.25rem 1.25rem"/>
                </div>
                <NativeView t-else="" t-key="state.version" t-props="nativeProps"/>
            </div>
        </div>
    </t>


</templates>
