<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The delivery slip loop calls the Modern Reports document instead of Odoo's. A plain view
         inheritance: uninstalling this addon brings Odoo's delivery slip back. -->
    <template id="report_deliveryslip" inherit_id="stock.report_deliveryslip">
        <xpath expr="//t[@t-call='stock.report_delivery_document']" position="attributes">
            <attribute name="t-call">modern_reports_stock.report_delivery_document</attribute>
        </xpath>
    </template>

    <template id="report_delivery_document">
        <t t-call="web.html_container">
            <t t-call="modern_reports.document">
                <t t-set="mr" t-value="o.with_context(lang=o._get_report_lang())._mr_values()"/>
            </t>
        </t>
    </template>

    <record id="stock.action_report_delivery" model="ir.actions.report">
        <field name="paperformat_id" ref="modern_reports.paperformat_modern"/>
    </record>

</odoo>
