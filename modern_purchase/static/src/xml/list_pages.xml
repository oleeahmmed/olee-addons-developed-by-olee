<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="modern_purchase.PageBar">
        <header class="mp-pagebar">
            <div class="mp-pagebar-title">
                <span t-if="props.icon" class="mp-pagebar-icon" aria-hidden="true"><i t-attf-class="fa {{ props.icon }}"/></span>
                <div class="min-w-0">
                    <h1 t-esc="props.title"/>
                    <p t-if="props.subtitle" t-esc="props.subtitle"/>
                </div>
            </div>
            <div class="mp-pagebar-actions">
                <t t-slot="default"/>
                <button t-if="props.onCreate" type="button" class="mp-btn mp-btn-primary mp-btn-new" data-hotkey="c"
                        t-att-title="(props.newLabel or 'New') + ' (Alt+C)'" t-on-click="() => props.onCreate()">
                    <i class="fa fa-plus" aria-hidden="true"/><span t-esc="props.newLabel or 'New'"/>
                </button>
            </div>
        </header>
    </t>

    <!-- Odoo's own layout, full width: control panel (New, title, search, pager, views) then the view. -->
    <t t-name="modern_purchase.ListPage">
        <div class="o_mp o_mp_page o_mp_page--native">
            <div class="mp-container mp-container--native">
                <PageBar title="page.title" subtitle="page.subtitle" icon="page.icon"
                         newLabel="page.newLabel" onCreate="canCreate ? (() => this.onNew()) : undefined"/>
                <div t-if="!state.ready" class="mp-card mp-native">
                    <div class="mp-skeleton" style="height:3.5rem;margin:1rem 1.25rem"/>
                    <div class="mp-skeleton" style="height:16rem;margin:0 1.25rem 1.25rem"/>
                </div>
                <NativeView t-else="" t-key="state.version" t-props="nativeProps"/>
            </div>
        </div>
    </t>


</templates>
